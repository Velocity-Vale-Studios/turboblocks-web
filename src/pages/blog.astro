---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { gradients } from 'src/components/gradients.js';

// Pobieramy wszystkie posty z folderu content/blog
const allPosts = await getCollection('blog');

// Mapujemy dane tak, aby pasowały do Twojego layoutu (wyciągamy dane z .data)
const posts = allPosts.map(post => ({
    ...post.data,
    url: `/blog/${post.slug}` // URL tworzy się automatycznie z nazwy pliku .md
}));

// Sortuj po datach (opcjonalnie, zależy od potrzeb) albo użyj jak leci
const headerGradient = gradients.aurora.cssAnimated;
const modesBlobL     = gradients.fuchsia_pulse.cssNeon;
const modesBlobR     = gradients.aurora.cssNeon;
---
<Layout title="Insides">
    <section class="max-w-7xl mx-auto px-8 py-16 md:py-24 relative mt-16 md:mt-24">
        
        {/* Background Ambient Glows */}
        <div class="absolute top-1/4 -left-10 w-[200px] md:w-[500px] h-[200px] md:h-[500px] blur-[80px] md:blur-[130px] -z-10 pointer-events-none neon-bg-animated opacity-20" style={`background: ${modesBlobL};`}></div>
        <div class="absolute bottom-1/4 -right-10 w-[200px] md:w-[500px] h-[200px] md:h-[500px] blur-[80px] md:blur-[130px] -z-10 pointer-events-none neon-bg-animated opacity-15" style={`background: ${modesBlobR}; animation-delay: 2s;`}></div>

        {/* HEADER */}
        <div style="--team-hex: #22d3ee; --team-rgb: 34,211,238;" class="mb-10 md:mb-16 flex flex-col items-center md:items-start text-center md:text-left relative z-10">
            <div class="flex items-center gap-3 mb-3">
                <div class="h-px w-8 transition-colors duration-700 header-left-line" style="background: var(--team-hex);"></div>
                <span class="text-[9px] font-black uppercase tracking-[0.6em] header-label transition-colors duration-700" style="color: var(--team-hex);">DEVLOG & NEWS</span>
                <div class="h-px w-8 transition-colors duration-700 header-right-line" style="background: var(--team-hex);"></div>
            </div>
            <h3 class="text-4xl sm:text-5xl md:text-7xl font-black italic text-white uppercase tracking-tighter leading-none">
                INSIDES <span class="neon-text-animated pr-4 header-crew" style={`background-image: ${headerGradient}; filter: drop-shadow(0 0 20px rgba(34,211,238,0.3));`}>FEED</span>
            </h3>
        </div>

        {/* POSTS GRID */}
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-4 items-stretch relative z-10">
            {posts.map((post) => (
                <div class={`m-0 md:-m-12 p-0 md:p-12 ${post.featured ? 'lg:col-span-2' : ''}`}>
                    <div class:list={[
                        "group relative p-6 md:p-14 rounded-[2.5rem] md:rounded-[4rem] border backdrop-blur-3xl transition-all duration-700 flex flex-col h-full bg-gradient-to-br from-white/5 to-white/[0.02]",
                        post.borderColorClass, post.glowClass
                    ]}>
                        
                        {/* Bloom i tła */}
                        <div class="absolute -inset-[60px] rounded-[2.5rem] md:rounded-[4rem] blur-[80px] -z-10 pointer-events-none transition-all duration-1000 opacity-15 group-hover:opacity-25" style="background-image: linear-gradient(to bottom right, var(--tw-gradient-stops));" class:list={[post.gradient]}></div>

                        <div class="relative z-10 flex flex-col h-full">
                            
                            {/* TOP ROW: Icon Box + Tag */}
                            <div class="flex justify-between items-start mb-6 md:mb-14">
                                
                                <div class:list={[
                                    "w-16 h-16 md:w-24 md:h-24 rounded-2xl md:rounded-[2rem] border flex items-center justify-center text-3xl md:text-5xl shadow-2xl transition-all duration-500 ease-out",
                                    "group-hover:scale-110 group-hover:border-current group-hover:shadow-current", post.borderAccent, post.bgAccent, post.accent
                                ]}>
                                    <div class="w-10 h-10 md:w-16 md:h-16 rounded-xl flex items-center justify-center text-2xl md:text-4xl transition-all duration-500 bg-white/5 border border-white/10 shadow-inner group-hover:border-current group-hover:shadow-[inset_0_0_15px_currentColor]">
                                        <span class="transform-gpu group-hover:animate-pulse text-white" aria-hidden="true">{post.icon}</span>
                                    </div>
                                </div>

                                <span class={`text-[9px] md:text-[11px] font-black uppercase tracking-[0.3em] py-2 px-4 md:py-3 md:px-6 rounded-xl border shadow-2xl ${post.accent} ${post.bgAccent} ${post.borderAccent}`}>
                                    {post.tag}
                                </span>
                            </div>

                            {/* TITLE */}
                            <h4 class={`text-3xl md:text-5xl lg:text-6xl font-black italic uppercase tracking-tighter mb-4 md:mb-8 leading-none neon-text-animated transition-colors duration-300 group-hover:text-transparent ${post.textHoverAccent}`}>
                                {post.title}
                            </h4>

                            {/* DESCRIPTION */}
                            <p class={`text-white/60 text-[13px] md:text-xl font-medium italic border-l-4 border-white/10 pl-6 md:pl-10 leading-snug md:leading-relaxed mb-6 md:mb-16 flex-grow ${post.featured ? 'max-w-4xl' : ''}`}>
                                {post.desc}
                            </p>

                            {/* FOOTER */}
                            <div class="mt-auto flex flex-row md:flex-wrap items-center gap-3 md:gap-4">
                                <a href={post.url} class={`flex-[2] md:flex-none text-center px-4 md:px-8 py-3.5 md:py-4 text-white font-black uppercase text-[10px] md:text-xs tracking-widest rounded-2xl transition-all duration-300 hover:scale-110 bg-white/5 border border-white/10 hover:text-white hover:border-transparent ${post.btnHoverAccent} ${post.shadowAccent}`}>
                                    READ ARTICLE
                                </a>
                                
                                <div class="flex-1 md:flex-none flex items-center justify-center px-3 md:px-5 py-3.5 md:py-4 bg-white/5 border border-white/10 rounded-2xl backdrop-blur-md">
                                    <div class="w-2 h-2 rounded-full mr-2 md:mr-3 border border-white/30 bg-white/10"></div>
                                    <span class="text-white/60 font-black text-[9px] md:text-xs uppercase tracking-widest whitespace-nowrap">
                                        {post.date}
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </section>
</Layout>
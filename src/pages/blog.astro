---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { gradients } from 'src/components/gradients.js';

const apiUrl = import.meta.env.PUBLIC_API_URL || "https://api.turboblocks.eu";

let posts: any[] = [];
try {
    const res = await fetch(`${apiUrl}/news/`);
    if (res.ok) {
        const apiPosts = await res.json();
        posts = apiPosts.map((post: any) => {
            // Parse hex color to rgb string for inline styles
            const hex = post.theme_color || "#06b6d4"; // default cyan
            const r = parseInt(hex.slice(1, 3), 16);
            const g = parseInt(hex.slice(3, 5), 16);
            const b = parseInt(hex.slice(5, 7), 16);
            const rgb = `${r}, ${g}, ${b}`;
            
            return {
                title: post.title,
                desc: post.description,
                date: new Date(post.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }),
                tag: post.tag,
                icon: post.icon || "📰",
                featured: post.featured,
                
                // Dynamic theme variables
                themeRgb: rgb,
                themeHex: hex,
                
                // We use dynamic inline styles below instead of these tailwind classes
                borderColorClass: "",
                glowClass: "",
                gradient: "",
                accent: "",
                bgAccent: "",
                borderAccent: "",
                textHoverAccent: "",
                btnHoverAccent: "",
                shadowAccent: "",
                url: `/blog/${post.id}`
            };
        });
    }
} catch (e) {
    console.error("Failed to fetch news", e);
}

// Zawsze dołączaj lokalne pliki .md
const allPosts = await getCollection('blog');
const localPosts = allPosts.map(post => {
    // Generuj sensowne domyślne style dla wpisów .md
    return {
        title: post.data.title,
        desc: post.data.description,
        date: new Date(post.data.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }),
        tag: "BLOG POST",
        icon: "📝",
        featured: false,
        borderColorClass: "border-fuchsia-500/30",
        glowClass: "shadow-[0_0_50px_rgba(217,70,239,0.15)] group-hover:shadow-[0_0_80px_rgba(217,70,239,0.3)]",
        gradient: "from-fuchsia-500 via-pink-500 to-rose-500",
        accent: "text-fuchsia-400",
        bgAccent: "bg-fuchsia-500/10",
        borderAccent: "border-fuchsia-500/30",
        textHoverAccent: "group-hover:from-fuchsia-400 group-hover:to-pink-500",
        btnHoverAccent: "hover:bg-fuchsia-500/20",
        shadowAccent: "hover:shadow-[0_0_20px_rgba(217,70,239,0.4)]",
        url: `/blog/${post.slug}`,
        themeHex: null, // identify local post
        ...post.data, // Pozwól nadpisać np. ikonę, tag czy featured z frontmatter
    };
});

posts = [...posts, ...localPosts];

// Sortuj po dacie i wyróżnieniu: Featured zawsze na górze, reszta po dacie (od najnowszych)
posts.sort((a, b) => {
    if (a.featured && !b.featured) return -1;
    if (!a.featured && b.featured) return 1;
    return new Date(b.date).getTime() - new Date(a.date).getTime();
});

const headerGradient = gradients.aurora.cssAnimated;
const modesBlobL     = gradients.fuchsia_pulse.cssNeon;
const modesBlobR     = gradients.aurora.cssNeon;
---
<Layout title="Insides">
    <section class="max-w-7xl mx-auto px-8 py-16 md:py-24 relative mt-16 md:mt-24">
        
        {/* Background Ambient Glows */}
        <div class="absolute top-1/4 -left-10 w-[200px] md:w-[500px] h-[200px] md:h-[500px] blur-[80px] md:blur-[130px] -z-10 pointer-events-none neon-bg-animated opacity-20" style={`background: ${modesBlobL};`}></div>
        <div class="absolute bottom-1/4 -right-10 w-[200px] md:w-[500px] h-[200px] md:h-[500px] blur-[80px] md:blur-[130px] -z-10 pointer-events-none neon-bg-animated opacity-15" style={`background: ${modesBlobR}; animation-delay: 2s;`}></div>

        {/* HEADER */}
        <div style="--team-hex: #22d3ee; --team-rgb: 34,211,238;" class="mb-10 md:mb-16 flex flex-col items-center md:items-start text-center md:text-left relative z-10">
            <div class="flex items-center gap-3 mb-3">
                <div class="h-px w-8 transition-colors duration-700 header-left-line" style="background: var(--team-hex);"></div>
                <span class="text-[9px] font-black uppercase tracking-[0.6em] header-label transition-colors duration-700" style="color: var(--team-hex);">DEVLOG & NEWS</span>
                <div class="h-px w-8 transition-colors duration-700 header-right-line" style="background: var(--team-hex);"></div>
            </div>
            <h3 class="text-4xl sm:text-5xl md:text-7xl font-black italic text-white uppercase tracking-tighter leading-none">
                INSIDES <span class="neon-text-animated pr-4 header-crew" style={`background-image: ${headerGradient}; filter: drop-shadow(0 0 20px rgba(34,211,238,0.3));`}>FEED</span>
            </h3>
        </div>

        {/* POSTS GRID */}
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-4 items-stretch relative z-10">
            {posts.map((post) => (
                <a href={post.url} class={`block m-0 md:-m-12 p-0 md:p-12 outline-none cursor-pointer ${post.featured ? 'lg:col-span-2' : ''}`} style={post.themeHex ? `--theme-rgb: ${post.themeRgb}; --theme-hex: ${post.themeHex};` : ''}>
                    <div class:list={[
                        "group relative p-6 md:p-14 rounded-[2.5rem] md:rounded-[4rem] border backdrop-blur-3xl transition-all duration-700 flex flex-col h-full bg-gradient-to-br from-white/5 to-white/[0.02]",
                        post.themeHex ? "border-[rgba(var(--theme-rgb),0.3)] shadow-[0_0_50px_rgba(var(--theme-rgb),0.15)] group-hover:shadow-[0_0_80px_rgba(var(--theme-rgb),0.3)]" : [post.borderColorClass, post.glowClass]
                    ]}>
                        
                        {/* Bloom i tła */}
                        <div class="absolute -inset-[60px] rounded-[2.5rem] md:rounded-[4rem] blur-[80px] -z-10 pointer-events-none transition-all duration-1000 opacity-15 group-hover:opacity-25" style={post.themeHex ? "background-image: linear-gradient(135deg, rgba(var(--theme-rgb), 0.8), transparent);" : "background-image: linear-gradient(to bottom right, var(--tw-gradient-stops));"} class:list={[!post.themeHex && post.gradient]}></div>

                        <div class="relative z-10 flex flex-col h-full">
                            
                            {/* TOP ROW: Icon Box + Tag */}
                            <div class="flex justify-between items-start mb-6 md:mb-14">
                                
                                <div class:list={[
                                    "w-16 h-16 md:w-24 md:h-24 rounded-2xl md:rounded-[2rem] border flex items-center justify-center text-3xl md:text-5xl shadow-2xl transition-all duration-500 ease-out",
                                    "group-hover:scale-110 group-hover:border-current group-hover:shadow-current",
                                    post.themeHex ? "border-[rgba(var(--theme-rgb),0.3)] bg-[rgba(var(--theme-rgb),0.1)] text-[var(--theme-hex)]" : [post.borderAccent, post.bgAccent, post.accent]
                                ]}>
                                    <div class="w-10 h-10 md:w-16 md:h-16 rounded-xl flex items-center justify-center text-2xl md:text-4xl transition-all duration-500 bg-white/5 border border-white/10 shadow-inner group-hover:border-current group-hover:shadow-[inset_0_0_15px_currentColor]">
                                        {post.icon && (post.icon.endsWith('.svg') || post.icon.endsWith('.png') || post.icon.startsWith('/')) ? (
                                            <img src={post.icon} class="w-full h-full object-contain p-2 transform-gpu group-hover:animate-pulse" alt="" />
                                        ) : (
                                            <span class="transform-gpu group-hover:animate-pulse text-white" aria-hidden="true">{post.icon}</span>
                                        )}
                                    </div>
                                </div>

                                <div class="flex flex-col items-end gap-2">
                                    <span class:list={[
                                        "text-[9px] md:text-[11px] font-black uppercase tracking-[0.3em] py-2 px-4 md:py-3 md:px-6 rounded-xl border shadow-2xl backdrop-blur-md",
                                        post.themeHex ? "border-[rgba(var(--theme-rgb),0.3)] bg-[rgba(var(--theme-rgb),0.1)] text-[var(--theme-hex)]" : [post.borderAccent, post.bgAccent, post.accent]
                                    ]}>
                                        {post.tag}
                                    </span>
                                    <span class="text-[9px] md:text-[10px] font-black uppercase tracking-[0.2em] text-white/50 mr-2">
                                        {post.date}
                                    </span>
                                </div>
                            </div>

                            {/* TITLE */}
                            <h4 class:list={[
                                "text-3xl md:text-5xl lg:text-6xl font-black italic uppercase tracking-tighter mb-4 md:mb-8 leading-none bg-clip-text text-transparent transition-colors duration-300",
                                post.themeHex ? "bg-gradient-to-br from-white to-[var(--theme-hex)] hover:text-[var(--theme-hex)]" : ["bg-gradient-to-r", post.gradient, post.textHoverAccent]
                            ]}>
                                {post.title}
                            </h4>

                            {/* DESCRIPTION */}
                            <p class={`text-white/60 text-[13px] md:text-xl font-medium italic border-l-4 border-white/10 pl-6 md:pl-10 leading-snug md:leading-relaxed flex-grow ${post.featured ? 'max-w-4xl' : ''}`}>
                                {post.desc}
                            </p>

                        </div>
                    </div>
                </a>
            ))}
        </div>
    </section>
</Layout>
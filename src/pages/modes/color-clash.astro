---
import Layout from "../../layouts/Layout.astro";
import data from "../../data/color_clash.json";
import { gradients } from "src/components/gradients.js";

const { mechanics, gameModes, regions } = data;
const modesGradient = gradients.aurora.cssAnimated;

const colors = {
    pink: {
        glow: "bg-[rgba(255,0,204,0.15)]",
        border: "border-[rgba(255,0,204,0.3)] group-hover:border-[rgba(255,0,204,0.6)]",
        shadow: "shadow-[0_0_30px_rgba(255,0,204,0.15)] group-hover:shadow-[0_0_50px_rgba(255,0,204,0.3)]",
        text: "text-[#FF00CC]",
        gradient: "aurora",
        rgb: "255,0,204",
        hex: "#FF00CC",
    },
    cyan: {
        glow: "bg-[rgba(0,225,253,0.15)]",
        border: "border-[rgba(0,225,253,0.3)] group-hover:border-[rgba(0,225,253,0.6)]",
        shadow: "shadow-[0_0_30px_rgba(0,225,253,0.15)] group-hover:shadow-[0_0_50px_rgba(0,225,253,0.3)]",
        text: "text-[#00E1FD]",
        gradient: "deep_space",
        rgb: "0,225,253",
        hex: "#00E1FD",
    },
    purple: {
        glow: "bg-[rgba(168,85,247,0.15)]",
        border: "border-[rgba(168,85,247,0.3)] group-hover:border-[rgba(168,85,247,0.6)]",
        shadow: "shadow-[0_0_30px_rgba(168,85,247,0.15)] group-hover:shadow-[0_0_50px_rgba(168,85,247,0.3)]",
        text: "text-[#A855F7]",
        gradient: "twilight",
        rgb: "168,85,247",
        hex: "#A855F7",
    },
    orange: {
        glow: "bg-[rgba(249,115,22,0.15)]",
        border: "border-[rgba(249,115,22,0.3)] group-hover:border-[rgba(249,115,22,0.6)]",
        shadow: "shadow-[0_0_30px_rgba(249,115,22,0.15)] group-hover:shadow-[0_0_50px_rgba(249,115,22,0.3)]",
        text: "text-[#F97316]",
        gradient: "inferno",
        rgb: "249,115,22",
        hex: "#F97316",
    },
    blue: {
        glow: "bg-[rgba(59,130,246,0.15)]",
        border: "border-[rgba(59,130,246,0.3)] group-hover:border-[rgba(59,130,246,0.6)]",
        shadow: "shadow-[0_0_30px_rgba(59,130,246,0.15)] group-hover:shadow-[0_0_50px_rgba(59,130,246,0.3)]",
        text: "text-[#3B82F6]",
        gradient: "pulsar",
        rgb: "59,130,246",
        hex: "#3B82F6",
    },
};
---

<Layout title="Color Clash - Gameplay Types">
    <div
        class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 pt-28 sm:pt-32 pb-24 md:pb-48 relative"
    >
        {/* --- HEADER --- */}
        <header
            class="mb-24 md:mb-40 flex flex-col items-start text-left relative group pt-10 md:pt-0"
        >
            {/* Massive Watermark */}
            <div
                class="absolute top-1/2 left-0 -translate-y-1/2 w-full text-left pointer-events-none -z-20 overflow-hidden flex justify-start opacity-[0.03] select-none mix-blend-overlay"
            >
                <span
                    class="text-[150px] md:text-[250px] lg:text-[350px] font-black italic uppercase tracking-tighter text-white whitespace-nowrap leading-none -ml-4 md:-ml-8"
                    >CLASH</span
                >
            </div>

            <div
                class="absolute -top-24 left-1/4 w-[300px] h-[300px] md:w-[600px] md:h-[600px] bg-purple-500/20 blur-[100px] md:blur-[150px] animate-pulse pointer-events-none -z-10"
            >
            </div>
            <div
                class="absolute bottom-0 right-1/4 w-[300px] h-[300px] md:w-[500px] md:h-[500px] bg-cyan-500/20 blur-[100px] md:blur-[150px] animate-pulse pointer-events-none -z-10"
                style="animation-delay: 2s;"
            >
            </div>

            <div
                class="flex items-center justify-start gap-3 md:gap-4 mb-6 md:mb-10 animate-fade-in-up"
            >
                <div
                    class="h-px w-12 md:w-24 transition-colors duration-700"
                    style="background: #00E1FD; box-shadow: 0 0 10px #00E1FD;"
                >
                </div>
                <span
                    class="text-[9px] md:text-[11px] font-black uppercase tracking-[0.4em] md:tracking-[0.6em]"
                    style="color: #00E1FD; text-shadow: 0 0 15px #00E1FD;"
                >
                    SPECTACLE-DRIVEN MODE
                </span>
                <div
                    class="h-px w-12 md:w-24 transition-colors duration-700"
                    style="background: #00E1FD; box-shadow: 0 0 10px #00E1FD;"
                >
                </div>
            </div>

            <h1
                class="text-5xl sm:text-7xl md:text-8xl lg:text-[120px] xl:text-[160px] font-black italic tracking-tighter leading-[0.9] uppercase flex flex-col md:flex-row items-start md:items-center justify-start gap-0 md:gap-6 mb-8 md:mb-12"
            >
                <span
                    class="text-white drop-shadow-[0_0_20px_rgba(255,255,255,0.1)] md:drop-shadow-[0_0_30px_rgba(255,255,255,0.1)]"
                >
                    COLOR
                </span>
                <span
                    class="neon-text-animated"
                    style={`background-image: ${modesGradient}; filter: drop-shadow(0 0 40px rgba(255,0,204,0.55));`}
                >
                    CLASH
                </span>
            </h1>

            <div
                class="flex flex-col sm:flex-row items-start sm:items-center justify-start gap-4 sm:gap-6 w-full sm:w-auto mt-4"
            >
                <button
                    class="relative w-full sm:w-[260px] flex items-center justify-center py-3 md:py-4 text-white font-black uppercase text-[10px] tracking-[0.3em] rounded-2xl transition-all duration-300 hover:scale-110 group"
                    style="background: #FF00CC; box-shadow: 0 0 20px rgba(255,0,204,0.45), 0 0 40px rgba(255,0,204,0.15);"
                >
                    <div
                        class="relative z-10 grid place-items-center w-full -translate-y-[1px] md:-translate-y-[2px]"
                    >
                        <span class="col-start-1 row-start-1 tracking-[0.3em]"
                            >PLAY NOW</span
                        >
                    </div>
                </button>

            </div>
        </header>

        {/* --- MECHANICS --- */}
        <section class="mb-24 md:mb-48 relative">
            <div
                class="absolute top-1/2 left-0 -translate-y-1/2 w-96 h-96 bg-pink-500/10 blur-[120px] animate-pulse pointer-events-none -z-10"
            >
            </div>

            <div
                style="--team-hex: #FF00CC; --team-rgb: 255,0,204;"
                class="mb-10 md:mb-16 flex flex-col items-center md:items-start text-center md:text-left relative z-10"
            >
                <div class="flex items-center gap-3 mb-3">
                    <div
                        class="h-px w-8 transition-colors duration-700 header-left-line"
                        style="background: var(--team-hex);"
                    >
                    </div>
                    <span
                        class="text-[9px] font-black uppercase tracking-[0.6em] header-label transition-colors duration-700"
                        style="color: var(--team-hex);">CORE SYSTEMS</span
                    >
                    <div
                        class="h-px w-8 transition-colors duration-700 header-right-line"
                        style="background: var(--team-hex);"
                    >
                    </div>
                </div>
                <h3
                    class="text-3xl sm:text-4xl md:text-6xl font-black italic text-white uppercase tracking-tighter leading-none"
                >
                    HOW IT <span
                        class="neon-text-animated pr-4 header-crew"
                        style={`background-image: ${modesGradient};`}
                        >WORKS</span
                    >
                </h3>
            </div>

            <div
                class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 auto-rows-fr"
            >
                {
                    mechanics.map((item, index) => (
                        <div
                            class={`group relative flex cursor-pointer transition-transform duration-500 ease-out hover:scale-[1.02] transform-gpu ${index === 0 ? "md:col-span-2 md:row-span-2" : ""}`}
                            role="button"
                            tabindex="0"
                            aria-label={`Open details for ${item.title}`}
                            onclick={`openModal('mechanics', '${item.id}')`}
                            onkeydown={`if(event.key==='Enter'||event.key===' '){event.preventDefault();openModal('mechanics', '${item.id}')}`}
                        >
                            <div
                                class={`absolute -inset-4 ${colors[item.color].glow} blur-[80px] opacity-0 group-hover:opacity-100 transition-all duration-700 pointer-events-none`}
                            />

                            <div
                                class={`relative flex flex-col w-full bg-gradient-to-br from-white/5 to-white/[0.02] backdrop-blur-3xl border rounded-[2.5rem] md:rounded-[4rem] p-6 md:p-10 transition-all duration-700 ${colors[item.color].border} ${colors[item.color].shadow}`}
                            >
                                <div
                                    class={`flex-grow flex flex-col items-center text-center ${index === 0 ? "md:justify-center" : ""}`}
                                >
                                    <div
                                        class={`w-14 h-14 ${index === 0 ? "md:w-32 md:h-32 text-2xl md:text-6xl mb-6 md:mb-10" : "md:w-20 md:h-20 text-2xl md:text-4xl mb-6 md:mb-8"} border rounded-2xl md:rounded-[2rem] flex items-center justify-center shadow-2xl transition-all duration-500 ease-out group-hover:rotate-12 group-hover:scale-110`}
                                        style={`background: rgba(${colors[item.color].rgb}, 0.08); border-color: rgba(${colors[item.color].rgb}, 0.3); box-shadow: inset 0 0 20px rgba(${colors[item.color].rgb}, 0.1), 0 0 20px rgba(${colors[item.color].rgb}, 0.2);`}
                                    >
                                        <span class="group-hover:animate-pulse">
                                            {item.icon}
                                        </span>
                                    </div>

                                    <h5
                                        class={`font-black italic text-white uppercase tracking-tighter mb-4 ${index === 0 ? "text-2xl md:text-5xl" : "text-2xl md:text-3xl"} neon-text-animated drop-shadow-[0_0_20px_rgba(var(--mode-rgb),0.35)]`}
                                        style={`background-image: linear-gradient(to right, ${colors[item.color].hex}, #FFF, ${colors[item.color].hex});`}
                                    >
                                        {item.title}
                                    </h5>

                                    <div
                                        class={`min-h-[80px] flex items-center ${index === 0 ? "md:max-w-md md:mx-auto" : ""}`}
                                    >
                                        <p
                                            class={`text-white/60 font-medium italic border-l-4 border-white/10 pl-4 line-clamp-3 ${index === 0 ? "text-sm md:text-lg" : "text-sm md:text-base"}`}
                                        >
                                            {item.shortDesc}
                                        </p>
                                    </div>
                                </div>

                                <div class="mt-8 pt-6 border-t border-white/5">
                                    <div
                                        class={`text-[10px] font-black uppercase tracking-widest ${colors[item.color].text} opacity-50 group-hover:opacity-100 transition-all duration-300`}
                                    >
                                        Technical Specs →
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>
        </section>

        {/* --- GAME MODES --- */}
        <section class="mb-24 md:mb-48 relative">
            <div
                class="absolute top-1/2 right-0 -translate-y-1/2 w-96 h-96 bg-purple-500/10 blur-[120px] animate-pulse pointer-events-none -z-10"
                style="animation-delay: 2s;"
            >
            </div>

            <div
                style="--team-hex: #00E1FD; --team-rgb: 0,225,253;"
                class="mb-10 md:mb-16 flex flex-col items-center md:items-start text-center md:text-left relative z-10"
            >
                <div class="flex items-center gap-3 mb-3">
                    <div
                        class="h-px w-8 transition-colors duration-700 header-left-line"
                        style="background: var(--team-hex);"
                    >
                    </div>
                    <span
                        class="text-[9px] font-black uppercase tracking-[0.6em] header-label transition-colors duration-700"
                        style="color: var(--team-hex);">CHOOSE ARENA</span
                    >
                    <div
                        class="h-px w-8 transition-colors duration-700 header-right-line"
                        style="background: var(--team-hex);"
                    >
                    </div>
                </div>
                <h3
                    class="text-3xl sm:text-4xl md:text-6xl font-black italic text-white uppercase tracking-tighter leading-none"
                >
                    CLASH <span
                        class="neon-text-animated pr-4 header-crew"
                        style={`background-image: ${modesGradient};`}
                        >MODES</span
                    >
                </h3>
            </div>

            <div class="flex flex-col gap-16 md:gap-32 w-full">
                {
                    gameModes.map((mode, index) => (
                        <div
                            class={`group relative flex flex-col ${index % 2 === 0 ? "md:flex-row" : "md:flex-row-reverse"} gap-8 md:gap-16 items-center cursor-pointer transition-transform duration-500 ease-out hover:scale-[1.02] transform-gpu`}
                            role="button"
                            tabindex="0"
                            aria-label={`Open details for ${mode.title}`}
                            onclick={`openModal('gameModes', '${mode.id}')`}
                            onkeydown={`if(event.key==='Enter'||event.key===' '){event.preventDefault();openModal('gameModes', '${mode.id}')}`}
                        >
                            {/* Image Side */}
                            <div
                                class={`flex-1 w-full aspect-video md:aspect-[4/3] rounded-[2.5rem] md:rounded-[4rem] overflow-hidden border transition-all duration-700 ${colors[mode.color].border} ${colors[mode.color].shadow} relative`}
                            >
                                <div
                                    class={`absolute inset-0 ${colors[mode.color].glow} mix-blend-overlay opacity-50 transition-opacity duration-500 group-hover:opacity-80 z-10 pointer-events-none`}
                                />
                                <img
                                    src={mode.media.url}
                                    alt={mode.title}
                                    class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-110"
                                />
                            </div>

                            {/* Content Side */}
                            <div
                                class={`flex-1 w-full flex flex-col ${index % 2 === 0 ? "md:items-start text-left" : "md:items-end md:text-right text-left"} justify-center`}
                            >
                                <div class="flex items-center gap-4 mb-6 md:mb-8">
                                    <div
                                        class="w-16 h-16 md:w-20 md:h-20 rounded-2xl md:rounded-[1.5rem] border flex items-center justify-center text-3xl md:text-4xl shadow-2xl transition-all duration-500 ease-out group-hover:rotate-12 group-hover:scale-110"
                                        style={`background: rgba(${colors[mode.color].rgb}, 0.08); border-color: rgba(${colors[mode.color].rgb}, 0.3); box-shadow: inset 0 0 20px rgba(${colors[mode.color].rgb}, 0.1), 0 0 20px rgba(${colors[mode.color].rgb}, 0.2);`}
                                    >
                                        <span class="group-hover:animate-pulse">
                                            {mode.icon}
                                        </span>
                                    </div>
                                    <span
                                        class={`text-[10px] md:text-xs font-black uppercase tracking-[0.3em] py-2 px-4 rounded-xl border shadow-2xl ${colors[mode.color].text}`}
                                        style={`background: rgba(${colors[mode.color].rgb}, 0.1); border-color: rgba(${colors[mode.color].rgb}, 0.3);`}
                                    >
                                        {mode.tag}
                                    </span>
                                </div>

                                <h5
                                    class={`text-4xl md:text-5xl lg:text-6xl font-black italic uppercase tracking-tighter mb-6 neon-text-animated drop-shadow-[0_0_20px_rgba(var(--mode-rgb),0.35)] transition-all duration-500`}
                                    style={`background-image: linear-gradient(to right, ${colors[mode.color].hex}, #FFF, ${colors[mode.color].hex});`}
                                >
                                    {mode.title}
                                </h5>

                                <p
                                    class={`text-white/60 text-base md:text-lg lg:text-xl leading-relaxed font-medium italic border-white/10 ${index % 2 === 0 ? "border-l-4 pl-6" : "border-l-4 md:border-l-0 md:border-r-4 pl-6 md:pl-0 md:pr-6"}`}
                                >
                                    {mode.shortDesc}
                                </p>

                                <div
                                    class={`mt-10 pt-6 border-t border-white/5 w-full flex items-center ${index % 2 === 0 ? "justify-start" : "justify-start md:justify-end"} opacity-30 group-hover:opacity-100 transition-opacity duration-300`}
                                >
                                    <span class="text-xs font-black uppercase tracking-widest text-white flex items-center gap-2">
                                        View Meta & Rules
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke-width="3"
                                            stroke="currentColor"
                                            class={`w-4 h-4 ${index % 2 === 0 ? "ml-1" : "ml-1 md:ml-0 md:mr-1 md:order-first md:rotate-180"} group-hover:translate-x-1 transition-transform`}
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"
                                            />
                                        </svg>
                                    </span>
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>
        </section>

        {/* --- REGIONS GRID (2 kolumny na desktopie) --- */}
        <section class="mb-24 md:mb-48 relative">
            <div
                class="absolute top-1/4 left-0 w-96 h-96 bg-cyan-500/10 blur-[120px] animate-pulse pointer-events-none -z-10"
            >
            </div>
            <div
                class="absolute bottom-1/4 right-0 w-96 h-96 bg-purple-500/10 blur-[120px] animate-pulse pointer-events-none -z-10"
                style="animation-delay: 2s;"
            >
            </div>

            <div
                style="--team-hex: #A855F7; --team-rgb: 168,85,247;"
                class="mb-10 md:mb-16 flex flex-col items-center md:items-start text-center md:text-left relative z-10"
            >
                <div class="flex items-center gap-3 mb-3">
                    <div
                        class="h-px w-8 transition-colors duration-700 header-left-line"
                        style="background: var(--team-hex);"
                    >
                    </div>
                    <span
                        class="text-[9px] font-black uppercase tracking-[0.6em] header-label transition-colors duration-700"
                        style="color: var(--team-hex);">WORLD ATLAS</span
                    >
                    <div
                        class="h-px w-8 transition-colors duration-700 header-right-line"
                        style="background: var(--team-hex);"
                    >
                    </div>
                </div>
                <h3
                    class="text-3xl sm:text-4xl md:text-6xl font-black italic text-white uppercase tracking-tighter leading-none"
                >
                    CHROMATIC <span
                        class="neon-text-animated pr-4 header-crew"
                        style={`background-image: ${modesGradient};`}
                        >REGIONS</span
                    >
                </h3>
            </div>

            <div
                class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 items-stretch"
            >
                {
                    regions.map((region) => (
                        <div
                            class={`group relative flex flex-col justify-end w-full aspect-[3/4] lg:aspect-[9/16] rounded-3xl md:rounded-[3rem] overflow-hidden border cursor-pointer transition-all duration-500 ease-out hover:scale-105 transform-gpu ${colors[region.color].border} ${colors[region.color].shadow}`}
                            role="button"
                            tabindex="0"
                            aria-label={`Open details for ${region.title}`}
                            onclick={`openModal('regions', '${region.id}')`}
                            onkeydown={`if(event.key==='Enter'||event.key===' '){event.preventDefault();openModal('regions', '${region.id}')}`}
                        >
                            {/* Background Media */}
                            <div class="absolute inset-0 w-full h-full -z-20">
                                {region.media &&
                                region.media.type === "video" ? (
                                    <video
                                        autoplay
                                        loop
                                        muted
                                        playsinline
                                        class="w-full h-full object-cover opacity-30 grayscale group-hover:grayscale-0 group-hover:opacity-60 transition-all duration-700 transform-gpu group-hover:scale-110"
                                    >
                                        <source
                                            src={region.media.url}
                                            type="video/mp4"
                                        />
                                    </video>
                                ) : region.media &&
                                  region.media.type === "image" ? (
                                    <img
                                        src={region.media.url}
                                        alt={region.title}
                                        class="w-full h-full object-cover opacity-30 grayscale group-hover:grayscale-0 group-hover:opacity-60 transition-all duration-700 transform-gpu group-hover:scale-110"
                                    />
                                ) : (
                                    <div class="w-full h-full bg-black" />
                                )}
                            </div>

                            {/* Gradient Overlay */}
                            <div class="absolute inset-0 bg-gradient-to-t from-black via-black/60 to-transparent -z-10 group-hover:translate-y-4 transition-transform duration-700" />

                            {/* Color Glow Overlay */}
                            <div
                                class={`absolute inset-0 ${colors[region.color].glow} opacity-0 group-hover:opacity-40 mix-blend-overlay transition-opacity duration-500 -z-10 pointer-events-none`}
                            />

                            {/* Content */}
                            <div class="relative p-6 md:p-8 flex flex-col justify-end h-full">
                                <div class="flex items-center gap-2 mb-4 opacity-70 group-hover:opacity-100 transition-opacity">
                                    <span
                                        class={`w-2 h-2 rounded-full animate-pulse ${region.id === "neon-city" ? "bg-green-500 shadow-[0_0_10px_#22c55e]" : "bg-amber-400 shadow-[0_0_10px_#fbbf24]"}`}
                                    />
                                    <span class="text-[8px] font-black text-white/60 uppercase tracking-widest">
                                        {region.id === "neon-city"
                                            ? "Available"
                                            : "Planned"}
                                    </span>
                                </div>

                                <div class="flex items-end gap-4 mb-2">
                                    <div
                                        class="w-12 h-12 rounded-xl border flex items-center justify-center text-xl shrink-0 shadow-2xl transition-all duration-500 group-hover:scale-110"
                                        style={`background: rgba(${colors[region.color].rgb}, 0.15); border-color: rgba(${colors[region.color].rgb}, 0.5); box-shadow: inset 0 0 15px rgba(${colors[region.color].rgb}, 0.3);`}
                                    >
                                        <span class="group-hover:animate-pulse">
                                            {region.icon}
                                        </span>
                                    </div>
                                    <h4
                                        class={`text-2xl md:text-3xl font-black italic uppercase tracking-tighter leading-none neon-text-animated drop-shadow-[0_0_20px_rgba(var(--mode-rgb),0.35)]`}
                                        style={`background-image: linear-gradient(to right, ${colors[region.color].hex}, #FFF, ${colors[region.color].hex});`}
                                    >
                                        {region.title.split(" ")[0]}
                                        <br />
                                        <span class="text-white">
                                            {region.title.split(" ")[1] || ""}
                                        </span>
                                    </h4>
                                </div>

                                <div class="grid grid-rows-[0fr] group-hover:grid-rows-[1fr] transition-all duration-500 ease-in-out">
                                    <div class="overflow-hidden">
                                        <p class="text-white/60 text-xs md:text-sm font-medium italic border-l-2 border-white/20 pl-3 mt-4 mb-2 line-clamp-3">
                                            {region.shortDesc}
                                        </p>
                                        <div class="text-[9px] font-black uppercase tracking-widest text-white/40 mt-2">
                                            Click to Explore →
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>
        </section>
    </div>

    {/* ======================== MODAL ======================== */}
    {/* Overlay */}
    <div
        id="info-modal"
        class="fixed inset-0 z-[200] opacity-0 pointer-events-none transition-opacity duration-500"
        role="dialog"
        aria-modal="true"
        aria-labelledby="desk-title"
    >
        <button
            type="button"
            class="absolute inset-0 bg-[#020202]/90 backdrop-blur-2xl"
            aria-label="Close modal"
            onclick="closeModal()"></button>

        {/* --- MOBILE: bottom sheet --- */}
        <div
            id="modal-mobile"
            class="md:hidden absolute bottom-0 left-0 right-0 translate-y-full transition-transform duration-500 ease-out h-[85vh] flex flex-col"
        >
            <div
                id="mob-glow"
                class="absolute -top-20 left-1/2 -translate-x-1/2 w-80 h-40 blur-[80px] pointer-events-none transition-colors duration-700"
            >
            </div>

            <div
                id="modal-inner-mobile"
                class="relative flex-grow bg-[#0a0a0a] border-t border-white/10 rounded-t-[2.5rem] overflow-hidden shadow-[0_-20px_60px_rgba(0,0,0,0.8)] flex flex-col transition-all duration-700"
            >
                <div
                    class="absolute top-0 left-0 w-full h-[1px] bg-gradient-to-r from-transparent via-white/30 to-transparent z-50"
                >
                </div>

                <div
                    id="mob-media-container"
                    class="w-full h-56 relative shrink-0"
                >
                    <div id="mob-media" class="w-full h-full hidden"></div>
                    <div
                        class="absolute inset-0 bg-gradient-to-b from-transparent via-[#0a0a0a]/60 to-[#0a0a0a] z-10 pointer-events-none"
                    >
                    </div>
                    <div
                        class="absolute top-4 left-1/2 -translate-x-1/2 w-12 h-1.5 bg-white/30 rounded-full z-20"
                    >
                    </div>
                </div>

                {/* Close Button Mobile - fixed position */}
                <button
                    type="button"
                    aria-label="Close modal"
                    onclick="closeModal()"
                    class="absolute top-4 right-5 z-50 w-9 h-9 flex items-center justify-center bg-black/60 backdrop-blur-md border border-white/20 text-white rounded-xl active:scale-90 transition-all"
                >
                    <svg
                        class="w-4 h-4"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        stroke-width="3"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M6 18L18 6M6 6l12 12"></path></svg
                    >
                </button>

                <div
                    id="mob-content"
                    class="flex-grow overflow-y-auto px-6 pb-12 flex flex-col relative z-20 -mt-12 custom-scrollbar"
                >
                    <div class="flex justify-between items-end mb-6">
                        <div
                            id="mob-icon-box"
                            class="shrink-0 w-24 h-24 border rounded-[1.8rem] flex items-center justify-center text-4xl shadow-2xl bg-[#0a0a0a] relative overflow-hidden transition-all duration-700"
                        >
                            <span
                                id="mob-icon"
                                class="relative z-10 drop-shadow-lg animate-pulse"
                                >🎨</span
                            >
                        </div>
                        <div
                            id="mob-tag-box"
                            class="px-4 py-2 rounded-xl border bg-black/50 backdrop-blur-md mb-2 shadow-xl transition-all duration-700"
                        >
                            <span
                                id="mob-tag"
                                class="text-[9px] font-black uppercase tracking-[0.3em] block leading-none"
                                >Info</span
                            >
                        </div>
                    </div>

                    <h2
                        id="mob-title"
                        class="text-4xl sm:text-5xl font-black italic text-white uppercase tracking-tighter leading-[0.9] mb-8"
                    >
                        Title
                    </h2>

                    <p
                        id="mob-desc"
                        class="text-white/70 text-base leading-relaxed font-medium italic border-l-4 border-white/10 pl-5 mb-10"
                    >
                        Opis...
                    </p>

                    <div id="mob-specs" class="grid grid-cols-1 gap-3"></div>
                </div>
            </div>
        </div>

        {/* --- DESKTOP: premium 2-column modal (md+) --- */}
        <div
            id="modal-desktop"
            class="hidden md:flex absolute inset-0 items-center justify-center p-6 lg:p-12"
        >
            <div
                id="modal-card-desktop"
                class="relative w-full max-w-6xl h-[80vh] min-h-[600px] scale-95 transition-transform duration-500 ease-out"
            >
                {/* Ambient glows */}
                <div
                    class="absolute -top-24 -left-24 w-[500px] h-[500px] blur-[120px] opacity-0 transition-all duration-1000 pointer-events-none"
                    id="desk-glow-1"
                >
                </div>
                <div
                    class="absolute -bottom-24 -right-24 w-[500px] h-[500px] blur-[120px] opacity-0 transition-all duration-1000 pointer-events-none"
                    id="desk-glow-2"
                >
                </div>

                <div
                    id="modal-inner-desktop"
                    class="relative w-full h-full bg-[#050505] backdrop-blur-3xl border rounded-[2.5rem] lg:rounded-[3.5rem] shadow-[0_0_100px_rgba(0,0,0,0.8)] overflow-hidden transition-all duration-700 flex flex-row"
                >
                    <div
                        class="absolute top-0 left-0 w-full h-[2px] bg-gradient-to-r from-transparent via-white/30 to-transparent z-50"
                    >
                    </div>

                    {/* Media Column (Left) */}
                    <div
                        id="desk-media-col"
                        class="w-1/2 h-full relative border-r border-white/5 bg-black overflow-hidden group/media"
                    >
                        <div id="desk-media" class="w-full h-full hidden"></div>
                        {/* Dramatic vignette over media */}
                        <div
                            class="absolute inset-0 bg-gradient-to-r from-transparent via-black/20 to-[#050505] pointer-events-none"
                        >
                        </div>
                        <div
                            class="absolute inset-0 bg-gradient-to-t from-[#050505]/80 via-transparent to-transparent pointer-events-none"
                        >
                        </div>
                        {/* Fallback pattern */}
                        <div
                            class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0IiBoZWlnaHQ9IjQiPjxyZWN0IHdpZHRoPSI0IiBoZWlnaHQ9IjQiIGZpbGw9IiNmZmYiIGZpbGwtb3BhY2l0eT0iMC4wNSIvPjwvc3ZnPg==')] opacity-20 pointer-events-none"
                        >
                        </div>
                    </div>

                    {/* Content Column (Right) */}
                    <div
                        id="desk-content-col"
                        class="w-1/2 h-full flex flex-col relative z-10 bg-gradient-to-br from-white/[0.03] to-transparent"
                    >
                        {/* Header area */}
                        <div
                            class="flex items-center justify-between px-12 pt-12 pb-6"
                        >
                            <div
                                id="desk-tag-box"
                                class="px-5 py-2 rounded-xl border shadow-xl bg-black/30 backdrop-blur-sm transition-all duration-700"
                            >
                                <span
                                    id="desk-tag"
                                    class="text-[10px] font-black uppercase tracking-[0.4em] block leading-none"
                                    >Info</span
                                >
                            </div>
                            <button
                                type="button"
                                aria-label="Close modal"
                                onclick="closeModal()"
                                class="w-12 h-12 flex items-center justify-center bg-white/5 border border-white/10 text-white/50 rounded-2xl hover:bg-white/20 hover:text-white hover:scale-105 active:scale-95 transition-all duration-300 shadow-xl"
                            >
                                <svg
                                    class="w-5 h-5"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                    stroke-width="2.5"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M6 18L18 6M6 6l12 12"></path>
                                </svg>
                            </button>
                        </div>

                        {/* Scrollable Content */}
                        <div
                            class="px-12 pb-12 flex-grow overflow-y-auto flex flex-col gap-10 custom-scrollbar"
                        >
                            <div class="flex items-center gap-8">
                                <div
                                    id="desk-icon-box"
                                    class="shrink-0 w-28 h-28 border rounded-[2rem] flex items-center justify-center text-5xl shadow-2xl bg-[#0a0a0a] transition-all duration-700"
                                >
                                    <span id="desk-icon" class="animate-pulse"
                                        >🎨</span
                                    >
                                </div>
                                <div class="flex flex-col justify-center">
                                    <h2
                                        id="desk-title"
                                        class="text-5xl lg:text-6xl font-black italic text-white uppercase tracking-tighter leading-[0.9]"
                                    >
                                        Title
                                    </h2>
                                </div>
                            </div>

                            <p
                                id="desk-desc"
                                class="text-white/70 text-lg lg:text-xl leading-relaxed font-medium italic border-l-4 border-white/10 pl-8 flex-grow"
                            >
                                Opis...
                            </p>

                            <div
                                id="desk-specs"
                                class="grid grid-cols-2 gap-4 mt-8"
                            >
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</Layout>

<style>
    @keyframes fade-in-up {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    .animate-fade-in-up {
        animation: fade-in-up 0.8s cubic-bezier(0.23, 1, 0.32, 1) forwards;
    }
</style>

<script is:inline define:vars={{ mechanics, gameModes, regions }}>
    const colorMap = {
        pink: {
            gradient: "aurora",
            text: "text-[#FF00CC]",
            border: "border-[rgba(255,0,204,0.3)]",
            glow: "bg-[rgba(255,0,204,0.15)]",
            rgb: "255,0,204",
        },
        cyan: {
            gradient: "deep_space",
            text: "text-[#00E1FD]",
            border: "border-[rgba(0,225,253,0.3)]",
            glow: "bg-[rgba(0,225,253,0.15)]",
            rgb: "0,225,253",
        },
        purple: {
            gradient: "twilight",
            text: "text-[#A855F7]",
            border: "border-[rgba(168,85,247,0.3)]",
            glow: "bg-[rgba(168,85,247,0.15)]",
            rgb: "168,85,247",
        },
        orange: {
            gradient: "inferno",
            text: "text-[#F97316]",
            border: "border-[rgba(249,115,22,0.3)]",
            glow: "bg-[rgba(249,115,22,0.15)]",
            rgb: "249,115,22",
        },
        blue: {
            gradient: "pulsar",
            text: "text-[#3B82F6]",
            border: "border-[rgba(59,130,246,0.3)]",
            glow: "bg-[rgba(59,130,246,0.15)]",
            rgb: "59,130,246",
        },
    };

    const categoryLabels = {
        mechanics: "Mechanika",
        gameModes: "Tryb Gry",
        regions: "Region",
    };

    function buildSpecsHTML(item, c) {
        if (!item.technical) return "";
        return Object.entries(item.technical)
            .map(
                ([key, value]) => `
            <div class="flex flex-col gap-1 p-3 bg-white/5 border border-white/5 rounded-2xl">
                <span class="text-[8px] font-black text-white/30 uppercase tracking-[0.2em]">${key}</span>
                <span class="text-[10px] font-black ${c.text} italic uppercase tracking-tight leading-tight">${value}</span>
            </div>`,
            )
            .join("");
    }

    function buildMediaHTML(item) {
        if (!item.media?.url) return null;
        if (item.media.type === "video")
            return `<video autoplay loop muted playsinline class="w-full h-full object-cover"><source src="${item.media.url}" type="video/mp4"></video>`;
        return `<img src="${item.media.url}" class="w-full h-full object-cover" alt="${item.title}" />`;
    }

    window.openModal = function (category, id) {
        const dataset = { mechanics, gameModes, regions }[category];
        const item = dataset.find((i) => i.id === id);
        if (!item) return;

        const c = colorMap[item.color] || colorMap.cyan;
        const label = categoryLabels[category] || category;
        const tagText =
            label.toUpperCase() +
            " // " +
            item.id.toUpperCase().replace(/-/g, " ");
        const mediaHTML = buildMediaHTML(item);
        const specsHTML = buildSpecsHTML(item, c);

        // Format markdown do HTML
        const formattedDesc = item.longDesc
            .replace(
                /\*\*(.*?)\*\*/g,
                '<span class="text-white font-black drop-shadow-md">$1</span>',
            )
            .replace(/\n/g, "<br/>");

        // --- Wypełnienie MOBILE ---
        document.getElementById("mob-tag").innerText = tagText;
        document.getElementById("mob-tag").className =
            `text-[9px] font-black uppercase tracking-[0.3em] block leading-none ${c.text}`;
        document.getElementById("mob-tag-box").style.cssText =
            `background: rgba(${c.rgb}, 0.1); border-color: rgba(${c.rgb}, 0.3);`;

        document.getElementById("mob-icon").innerText = item.icon;
        const mobIconBox = document.getElementById("mob-icon-box");
        mobIconBox.className = `shrink-0 w-24 h-24 border rounded-[1.8rem] flex items-center justify-center text-4xl shadow-2xl bg-[#0a0a0a] relative overflow-hidden transition-all duration-700`;
        mobIconBox.style.cssText = `border-color: rgba(${c.rgb}, 0.3); box-shadow: inset 0 0 30px rgba(${c.rgb}, 0.15), 0 0 20px rgba(${c.rgb}, 0.2);`;

        document.getElementById("mob-title").innerText = item.title;
        document.getElementById("mob-desc").innerHTML = formattedDesc;

        const mobMedia = document.getElementById("mob-media");
        const mobMediaContainer = document.getElementById(
            "mob-media-container",
        );
        const mobContent = document.getElementById("mob-content");
        if (mediaHTML) {
            mobMedia.innerHTML = mediaHTML;
            mobMedia.classList.remove("hidden");
            mobMediaContainer.classList.remove("hidden");
            mobContent.classList.add("-mt-12");
            mobContent.classList.remove("pt-8");
            document
                .getElementById("mob-icon-box")
                .classList.add("shadow-[0_-10px_30px_rgba(0,0,0,0.8)]");
        } else {
            mobMedia.innerHTML = "";
            mobMedia.classList.add("hidden");
            mobMediaContainer.classList.add("hidden");
            mobContent.classList.remove("-mt-12");
            mobContent.classList.add("pt-8");
            document
                .getElementById("mob-icon-box")
                .classList.remove("shadow-[0_-10px_30px_rgba(0,0,0,0.8)]");
        }

        document.getElementById("mob-specs").innerHTML = specsHTML;

        const mobGlow = document.getElementById("mob-glow");
        mobGlow.className = `absolute -top-20 left-1/2 -translate-x-1/2 w-80 h-40 ${c.glow} blur-[80px] pointer-events-none transition-colors duration-700`;

        const innerMob = document.getElementById("modal-inner-mobile");
        innerMob.className = innerMob.className
            .replace(
                /border-\[rgba\([^\]]+\)\](\sgroup-hover:border-\[rgba\([^\]]+\)\])?/g,
                "",
            )
            .trim();
        innerMob.className += " " + c.border;

        // --- Wypełnienie DESKTOP ---
        document.getElementById("desk-tag").innerText = tagText;
        document.getElementById("desk-tag").className =
            `text-[10px] font-black uppercase tracking-[0.4em] block leading-none ${c.text}`;
        document.getElementById("desk-tag-box").style.cssText =
            `background: rgba(${c.rgb}, 0.1); border-color: rgba(${c.rgb}, 0.3);`;

        document.getElementById("desk-icon").innerText = item.icon;
        const deskIconBox = document.getElementById("desk-icon-box");
        deskIconBox.className = `shrink-0 w-28 h-28 border rounded-[2rem] flex items-center justify-center text-5xl shadow-2xl bg-[#0a0a0a] transition-all duration-700`;
        deskIconBox.style.cssText = `border-color: rgba(${c.rgb}, 0.4); box-shadow: inset 0 0 40px rgba(${c.rgb}, 0.2), 0 0 30px rgba(${c.rgb}, 0.3);`;

        document.getElementById("desk-title").innerText = item.title;
        document.getElementById("desk-desc").innerHTML = formattedDesc;

        const deskMedia = document.getElementById("desk-media");
        const deskMediaCol = document.getElementById("desk-media-col");
        const deskContentCol = document.getElementById("desk-content-col");

        if (mediaHTML) {
            deskMedia.innerHTML = mediaHTML;
            deskMedia.classList.remove("hidden");
            deskMediaCol.classList.remove("hidden");
            deskContentCol.className =
                "w-1/2 h-full flex flex-col relative z-10 bg-gradient-to-br from-white/[0.03] to-transparent";
        } else {
            deskMedia.innerHTML = "";
            deskMedia.classList.add("hidden");
            deskMediaCol.classList.add("hidden");
            deskContentCol.className =
                "w-full h-full flex flex-col relative z-10 bg-gradient-to-br from-white/[0.03] to-transparent";
        }
        document.getElementById("desk-specs").innerHTML = specsHTML;

        // Glow desktop
        const deskG1 = document.getElementById("desk-glow-1");
        const deskG2 = document.getElementById("desk-glow-2");
        deskG1.className = `absolute -top-24 -left-24 w-[500px] h-[500px] bg-gradient-${c.gradient}-diag blur-[120px] opacity-40 transition-all duration-1000 pointer-events-none`;
        deskG2.className = `absolute -bottom-24 -right-24 w-[500px] h-[500px] bg-gradient-${c.gradient}-diag blur-[120px] opacity-30 transition-all duration-1000 pointer-events-none`;

        // Border desktop
        const innerDesk = document.getElementById("modal-inner-desktop");
        innerDesk.className = innerDesk.className
            .replace(
                /border-\[rgba\([^\]]+\)\](\sgroup-hover:border-\[rgba\([^\]]+\)\])?/g,
                "",
            )
            .trim();
        innerDesk.className += " " + c.border;

        // --- Pokaż overlay ---
        const modal = document.getElementById("info-modal");
        modal.classList.remove("opacity-0", "pointer-events-none");

        // Mobile: wysuń z dołu
        const mobSheet = document.getElementById("modal-mobile");
        mobSheet.classList.remove("translate-y-full");
        mobSheet.classList.add("translate-y-0");

        // Desktop: scale in
        const deskCard = document.getElementById("modal-card-desktop");
        deskCard.classList.remove("scale-95");
        deskCard.classList.add("scale-100");

        document.body.style.overflow = "hidden";
    };

    window.closeModal = function () {
        const modal = document.getElementById("info-modal");
        modal.classList.add("opacity-0", "pointer-events-none");

        const mobSheet = document.getElementById("modal-mobile");
        mobSheet.classList.remove("translate-y-0");
        mobSheet.classList.add("translate-y-full");

        const deskCard = document.getElementById("modal-card-desktop");
        deskCard.classList.remove("scale-100");
        deskCard.classList.add("scale-95");

        document.body.style.overflow = "";
        modal.querySelectorAll("video").forEach((v) => v.pause());
    };

    window.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeModal();
    });
</script>

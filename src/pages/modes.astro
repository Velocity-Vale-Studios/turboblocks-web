---
import Layout from '../layouts/Layout.astro';
import { gradients } from 'src/components/gradients.js';

// Color Clash Mode Colors
const activeHex = '#FF00CC';
const activeRgb = '255,0,204';
const btnGradientActive = 'linear-gradient(to right, #FF00CC, #FF69B4, #FF00CC)';

// Rocky Raceway Mode Colors
const upcomingHex = '#00E1FD';
const upcomingRgb = '0,225,253';
const btnGradientUpcoming = 'linear-gradient(to right, #00E1FD, #00BFFF, #00E1FD)';

const modesGradient = gradients.aurora.cssAnimated;
const pulseDiag = gradients.fuchsia_pulse.cssDiag;
const pulsarDiag = gradients.pulsar.cssDiag;
---

<Layout title="Game Modes">
    <div class="max-w-7xl mx-auto px-8 pt-32 pb-16 md:pt-48 md:pb-32 relative">

        {/* HEADER */}
        <div style={`--theme-hex: #00E1FD; --theme-rgb: 0,225,253;`} class="mb-10 md:mb-16 flex flex-col items-center md:items-start text-center md:text-left relative z-10">
            <div class="absolute -top-10 md:-top-20 -left-10 md:-left-20 w-64 md:w-96 h-64 md:h-96 bg-purple-500/20 blur-[100px] md:blur-[150px] -z-10"></div>
            
            <div class="flex items-center gap-3 mb-3">
                <div class="h-px w-8 transition-colors duration-700" style="background: var(--theme-hex);"></div>
                <span class="text-[9px] sm:text-[10px] font-black uppercase tracking-[0.4em] sm:tracking-[0.6em] transition-colors duration-700" style="color: var(--theme-hex);">READY TO PLAY</span>
                <div class="h-px w-8 transition-colors duration-700" style="background: var(--theme-hex);"></div>
            </div>
            
            <h1 class="text-4xl sm:text-5xl md:text-7xl font-black italic text-white uppercase tracking-tighter leading-none">
                CURRENT <span class="neon-text-animated pr-4 md:pr-10" style={`background-image: ${modesGradient}; filter: drop-shadow(0 0 20px rgba(0,225,253,0.3));`}>MODE</span>
            </h1>
        </div>

        {/* AKTUALNY TRYB */}
        <section class="mb-16 md:mb-24">
            <div style={`--mode-hex: ${activeHex}; --mode-rgb: ${activeRgb};`} class:list={[
                "group relative p-6 md:p-14 rounded-[2.5rem] md:rounded-[4rem] border backdrop-blur-3xl transition-all duration-700 flex flex-col md:flex-row items-center md:items-start gap-10 md:gap-16 bg-gradient-to-br from-white/5 to-white/[0.02]",
                "border-[rgba(var(--mode-rgb),0.3)] hover:border-[rgba(var(--mode-rgb),0.6)]",
                "shadow-[0_0_50px_rgba(var(--mode-rgb),0.3)] hover:shadow-[0_0_80px_rgba(var(--mode-rgb),0.45)]"
            ]}>
                
                {/* Bloom */}
                <div class="absolute -inset-[60px] rounded-[2.5rem] md:rounded-[4rem] blur-[80px] -z-10 pointer-events-none transition-all duration-1000 opacity-15" style={`background-image: ${pulseDiag};`}></div>
                
                {/* IKONA */}
                <div class="relative shrink-0 mt-2 md:mt-0">
                    <div class:list={[
                        "w-24 h-24 md:w-32 md:h-32 rounded-[2rem] md:rounded-[2.5rem] border border-white/10 flex items-center justify-center text-4xl md:text-6xl shadow-2xl transition-all duration-500 ease-out",
                        "group-hover:scale-110 group-hover:border-[rgba(var(--mode-rgb),0.5)] group-hover:shadow-[0_0_40px_rgba(var(--mode-rgb),0.4)]",
                        "bg-white/5 rotate-3 group-hover:rotate-6"
                    ]}>
                        <div class="w-16 h-16 md:w-20 md:h-20 rounded-xl flex items-center justify-center text-3xl md:text-5xl transition-all duration-500"
                             style={`background: linear-gradient(135deg, rgba(var(--mode-rgb),0.08), rgba(124,58,237,0.04)); box-shadow: 0 0 28px rgba(var(--mode-rgb),0.18), inset 0 0 6px rgba(var(--mode-rgb),0.06); border: 1px solid rgba(var(--mode-rgb),0.15);`}>
                            <span class="transform-gpu" aria-hidden="true">🎨</span>
                        </div>
                        <div class="absolute -bottom-2 -right-2 md:-bottom-4 md:-right-4 bg-white text-black px-3 py-1.5 md:px-4 md:py-2 rounded-lg md:rounded-xl text-[8px] md:text-xs font-black uppercase tracking-widest shadow-[0_0_20px_rgba(255,255,255,0.3)]">
                            BETA
                        </div>
                    </div>
                </div>

                {/* TREŚĆ */}
                <div class="flex-grow w-full text-center md:text-left">
                    <div class="flex items-center justify-center md:justify-start gap-4 mb-6 md:mb-10">
                        <span class="text-[9px] md:text-[11px] font-black uppercase tracking-[0.3em] py-2 px-4 md:py-3 md:px-6 rounded-xl border border-white/10 shadow-2xl"
                              style={`color: var(--mode-hex); background: rgba(var(--mode-rgb), 0.08); box-shadow: inset 0 0 0 1px rgba(var(--mode-rgb),0.25);`}>
                            VERSION 1.21.1+
                        </span>
                        <div class="w-1.5 h-1.5 bg-white/20 rounded-full"></div>
                        <span class="text-white/40 font-black text-[9px] md:text-xs uppercase tracking-[0.2em] md:tracking-[0.3em]">PVP / Minigame</span>
                    </div>

                    <h2 class="text-4xl md:text-6xl lg:text-8xl font-black italic uppercase tracking-tighter mb-6 md:mb-8 leading-none neon-text-animated"
                        style={`background-image: ${btnGradientActive}; filter: drop-shadow(0 0 20px rgba(var(--mode-rgb),0.35));`}>
                        COLOR CLASH
                    </h2>

                    <p class="text-white/60 text-[13px] md:text-xl font-medium italic border-l-4 border-white/10 pl-6 md:pl-10 leading-snug md:leading-relaxed mb-8 md:mb-12 max-w-2xl mx-auto md:mx-0">
                        Paint the arena in your team's colors, eliminate opponents, and seize control of strategic points. The most dynamic mode of the season!
                    </p>

                    <div class="flex flex-col md:flex-row items-center gap-4">
                        <a href="/modes/color-clash" 
                           class="w-full md:w-auto text-center px-8 md:px-10 py-4 text-white font-black uppercase text-[10px] md:text-xs tracking-widest rounded-2xl transition-all duration-300 hover:scale-110" 
                           style={`background: var(--mode-hex); box-shadow: 0 0 20px rgba(var(--mode-rgb),0.45), 0 0 40px rgba(var(--mode-rgb),0.15);`}>
                            Explore Mode
                        </a>
                    </div>
                </div>
            </div>
        </section>

        {/* KOLEJNE TRYBY WKRÓTCE */}
        <div class="my-16 md:my-32 flex items-center justify-center gap-4 md:gap-8 overflow-hidden">
            <div class="h-[1px] w-16 md:w-32 bg-gradient-to-r from-transparent to-white/10"></div>
            <span class="text-[7px] md:text-[10px] font-black text-white/20 uppercase tracking-[0.4em] md:tracking-[0.8em] whitespace-nowrap">More modes coming soon...</span>
            <div class="h-[1px] w-16 md:w-32 bg-gradient-to-l from-transparent to-white/10"></div>
        </div>

        {/* COMING SOON CARD */}
        <section class="opacity-80 hover:opacity-100 transition-opacity duration-700">
            <div style={`--mode-hex: ${upcomingHex}; --mode-rgb: ${upcomingRgb};`} class:list={[
                "group relative p-6 md:p-14 rounded-[2.5rem] md:rounded-[4rem] border backdrop-blur-3xl transition-all duration-700 flex flex-col md:flex-row items-center md:items-start gap-10 md:gap-16 bg-gradient-to-br from-white/5 to-white/[0.02]",
                "border-[rgba(var(--mode-rgb),0.3)] hover:border-[rgba(var(--mode-rgb),0.6)]",
                "shadow-[0_0_50px_rgba(var(--mode-rgb),0.3)] hover:shadow-[0_0_80px_rgba(var(--mode-rgb),0.45)]"
            ]}>
                
                {/* Bloom */}
                <div class="absolute -inset-[60px] rounded-[2.5rem] md:rounded-[4rem] blur-[80px] -z-10 pointer-events-none transition-all duration-1000 opacity-15" style={`background-image: ${pulsarDiag}; animation-delay: 2s;`}></div>
                
                {/* IKONA */}
                <div class="relative shrink-0 mt-2 md:mt-0">
                    <div class:list={[
                        "w-24 h-24 md:w-32 md:h-32 rounded-[2rem] md:rounded-[2.5rem] border border-white/10 flex items-center justify-center text-4xl md:text-6xl shadow-2xl transition-all duration-500 ease-out",
                        "group-hover:scale-110 group-hover:border-[rgba(var(--mode-rgb),0.5)] group-hover:shadow-[0_0_40px_rgba(var(--mode-rgb),0.4)]",
                        "bg-black/20 grayscale group-hover:grayscale-0 group-hover:rotate-6"
                    ]}>
                        <div class="w-16 h-16 md:w-20 md:h-20 rounded-xl flex items-center justify-center text-3xl md:text-5xl transition-all duration-500"
                             style={`background: linear-gradient(135deg, rgba(var(--mode-rgb),0.08), rgba(124,58,237,0.04)); box-shadow: 0 0 28px rgba(var(--mode-rgb),0.18), inset 0 0 6px rgba(var(--mode-rgb),0.06); border: 1px solid rgba(var(--mode-rgb),0.15);`}>
                            <span class="transform-gpu" aria-hidden="true">🏎️</span>
                        </div>
                    </div>
                </div>

                {/* TREŚĆ */}
                <div class="flex-grow w-full text-center md:text-left">
                    <div class="flex items-center justify-center md:justify-start gap-4 mb-6 md:mb-10">
                        <span class="text-[9px] md:text-[11px] font-black uppercase tracking-[0.3em] py-2 px-4 md:py-3 md:px-6 rounded-xl border border-white/10 shadow-2xl"
                              style={`color: var(--mode-hex); background: rgba(var(--mode-rgb), 0.08); box-shadow: inset 0 0 0 1px rgba(var(--mode-rgb),0.25);`}>
                            FUTURE UPDATE
                        </span>
                    </div>

                    <h2 class="text-4xl md:text-6xl lg:text-8xl font-black italic uppercase tracking-tighter mb-6 md:mb-8 leading-none neon-text-animated opacity-40 group-hover:opacity-100 transition-opacity duration-700"
                        style={`background-image: ${btnGradientUpcoming}; filter: drop-shadow(0 0 20px rgba(var(--mode-rgb),0.35));`}>
                        ROCKY RACEWAY
                    </h2>

                    <p class="text-white/60 text-[13px] md:text-xl font-medium italic border-l-4 border-white/10 pl-6 md:pl-10 leading-snug md:leading-relaxed mb-8 md:mb-12 max-w-2xl mx-auto md:mx-0">
                        Extreme block-physics racing. Coming soon.
                    </p>

                    <div class="flex flex-col md:flex-row items-center gap-4">
                        <div class="w-full md:w-auto text-center px-8 md:px-10 py-4 bg-white/5 border border-white/10 rounded-2xl text-white/20 font-black uppercase text-[10px] md:text-xs tracking-widest italic cursor-not-allowed">
                            Coming Soon...
                        </div>
                    </div>
                </div>
            </div>
        </section>

    </div>
</Layout>
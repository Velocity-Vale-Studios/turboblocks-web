---
const { active } = Astro.props;
---

<div id="visual-window" class={`lg:col-span-5 bg-gradient-to-br from-white/5 to-white/[0.02] backdrop-blur-3xl border-[rgba(var(--team-rgb,${active.rgb}),0.3)] hover:border-[rgba(var(--team-rgb,${active.rgb}),0.6)] rounded-[2.5rem] lg:rounded-[4rem] relative overflow-hidden min-h-[400px] lg:min-h-[600px] flex items-center justify-center shadow-[0_0_50px_rgba(var(--team-rgb,${active.rgb}),0.3)] hover:shadow-[0_0_80px_rgba(var(--team-rgb,${active.rgb}),0.45)] transition-all duration-700`}>

    <!-- Scanlines overlay (jasniejsze, by nie przyciemniać grafiki) -->
    <div class="absolute inset-0 pointer-events-none opacity-[0.04]" style="background: repeating-linear-gradient(0deg, transparent, transparent 3px, rgba(255,255,255,1) 3px, rgba(255,255,255,1) 4px);"></div>

    <!-- Ink splat blob w tle (Splatoon vibe) -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden">
        <div class="absolute top-[10%] left-[15%] w-[70%] h-[70%] opacity-20 transition-all duration-1000" style={`background: radial-gradient(ellipse at center, rgba(var(--team-rgb, ${active.rgb}), 0.85) 0%, transparent 70%); border-radius: 60% 40% 55% 45% / 50% 60% 40% 50%; filter: blur(20px);`}></div>
        <!-- Speed lines radial burst -->
        <div class="absolute inset-0 opacity-10" style={`background: repeating-conic-gradient(from 0deg at 50% 110%, transparent 0deg, transparent 10deg, rgba(var(--team-rgb, ${active.rgb}), 0.4) 10deg, rgba(var(--team-rgb, ${active.rgb}), 0.4) 11deg);`}></div>
    </div>

    <!-- Skin image -->
    <div id="visual-anim-target" class="absolute inset-0 flex items-center justify-center p-4 lg:p-10 z-10 slide-anim">
        <img
                id="m-body"
                src={`https://mc-heads.net/body/${active.name}/400`}
                alt={active.name}
                class="h-[65%] lg:h-[75%] w-auto object-contain transition-all duration-700 pb-16 lg:pb-24"
                style={`filter: drop-shadow(0 0 35px rgba(var(--team-rgb, ${active.rgb}), 0.65)) drop-shadow(0 0 12px white);`}
        />
    </div>

    <!-- Nameplate dolny -->
    <div class="absolute bottom-4 lg:bottom-6 left-4 lg:left-6 right-4 lg:right-6 p-4 lg:p-6 backdrop-blur-xl border border-white/10 rounded-[1.2rem] lg:rounded-[1.8rem] z-20 overflow-hidden" style="background: rgba(0,0,0,0.35);">

        <!-- Neonowa linia górna nameplate -->
        <div id="nameplate-neon" class="absolute top-0 left-0 right-0 h-[2px] transition-all duration-700" style={`background: linear-gradient(to right, transparent, rgba(var(--team-rgb, ${active.rgb}), 0.8), transparent);`}></div>

        <div class="flex items-center justify-between">
            <div>
                <span id="m-visual-name" class="text-2xl lg:text-4xl font-black italic text-white uppercase tracking-tighter leading-none block">{active.name}</span>
                <span id="m-visual-role" class="text-[8px] lg:text-[10px] font-black uppercase tracking-[0.4em] text-white/50 mt-1 block">{active.role}</span>
            </div>
            <!-- Główka -->
            <div class="w-10 h-10 lg:w-14 lg:h-14 rounded-lg lg:rounded-xl border flex items-center justify-center flex-shrink-0 transition-all duration-700 overflow-hidden" style={`border-color: rgba(var(--team-rgb, ${active.rgb}), 0.4); background: rgba(var(--team-rgb, ${active.rgb}), 0.1);`}>
                <img id="m-star" class="w-full h-full object-cover transition-all duration-700" src={`https://mc-heads.net/avatar/${active.name}/80`} alt={active.name} />
            </div>
        </div>
    </div>
</div>


---
import { gradients } from 'src/components/gradients.js';

interface Props {
    ip: string;
    label: string;
}
const { ip } = Astro.props;

const borderGradient = gradients.maritime.cssAnimated;   // #4169E1 → #7C3AED → #00BFFF
const copiedGradient = gradients.maritime.cssAnimated;
---

<button
    id="heroCopyBtn"
    type="button"
    data-ip={ip}
    data-border-gradient={borderGradient}
    data-copied-gradient={copiedGradient}
    aria-label="Copy server IP address"
    class="relative flex items-center justify-center px-8 py-4 md:px-12 md:py-5 rounded-2xl font-bold font-sans text-base md:text-xl tracking-widest uppercase overflow-hidden transition-transform duration-300 hover:scale-105 active:scale-95 transform-gpu neon-bg-animated"
    style={`background: ${borderGradient}; background-size: 200% auto; color: #fff; box-shadow: 0 0 20px rgba(65,105,225,0.45), 0 0 50px rgba(0,191,255,0.15);`}
>
    <!-- Hollow mask — covers the fill, leaving only a 2px border -->
    <div class="absolute inset-[2px] rounded-[14px] z-0 pointer-events-none" style="background: #0a0a14;"></div>

    <div class="relative z-10 grid place-items-center w-full">
        <span id="heroTextDefault" class="col-start-1 row-start-1 transition-all duration-300 opacity-100 scale-100"
              style="color: #a5b4fc;">
            {ip}
        </span>
        <span id="heroTextCopied" class="col-start-1 row-start-1 transition-all duration-300 opacity-0 scale-90 absolute font-black italic text-white"
              style="text-shadow: 0 0 20px rgba(0,191,255,0.9);">
            COPIED!
        </span>
    </div>
</button>

<script>
    const heroBtn         = document.getElementById('heroCopyBtn') as HTMLButtonElement | null;
    const heroMask        = heroBtn?.querySelector('div.absolute') as HTMLElement | null;
    const heroTextDefault = document.getElementById('heroTextDefault');
    const heroTextCopied  = document.getElementById('heroTextCopied');

    async function copyText(value: string) {
        if (!value) return;
        try {
            await navigator.clipboard.writeText(value);
        } catch {
            const helper = document.createElement('textarea');
            helper.value = value;
            helper.setAttribute('readonly', '');
            helper.style.position = 'absolute';
            helper.style.left = '-9999px';
            document.body.appendChild(helper);
            helper.select();
            document.execCommand('copy');
            document.body.removeChild(helper);
        }
    }

    if (heroBtn && !heroBtn.dataset.copyBound) {
        heroBtn.dataset.copyBound = 'true';

        const copiedGradient  = heroBtn.dataset.copiedGradient!;
        const borderGradient  = heroBtn.dataset.borderGradient!;

        heroBtn.addEventListener('click', async () => {
            const ip = heroBtn.getAttribute('data-ip') || '';
            await copyText(ip);

            // Filled animated gradient — hide the hollow mask
            if (heroMask) heroMask.style.opacity = '0';
            heroBtn.style.boxShadow = '0 0 30px rgba(65,105,225,0.7), 0 0 70px rgba(0,191,255,0.25)';

            heroTextDefault?.classList.replace('opacity-100', 'opacity-0');
            heroTextDefault?.classList.add('scale-90');
            heroTextCopied?.classList.replace('opacity-0', 'opacity-100');
            heroTextCopied?.classList.replace('scale-90', 'scale-100');

            setTimeout(() => {
                // Back to border-only state
                if (heroMask) heroMask.style.opacity = '1';
                heroBtn.style.boxShadow = '0 0 20px rgba(65,105,225,0.45), 0 0 50px rgba(0,191,255,0.15)';

                heroTextDefault?.classList.replace('opacity-0', 'opacity-100');
                heroTextDefault?.classList.remove('scale-90');
                heroTextCopied?.classList.replace('opacity-100', 'opacity-0');
                heroTextCopied?.classList.replace('scale-100', 'scale-90');
            }, 1800);
        });
    }
</script>

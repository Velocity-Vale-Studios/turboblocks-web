---
interface Props {
    ip: string;
    label: string;
}
const { ip } = Astro.props;
---

<button
    id="heroCopyBtn"
    type="button"
    data-ip={ip}
    aria-label="Copy server IP address"
    class="relative flex items-center justify-center px-8 py-4 md:px-12 md:py-5 rounded-2xl font-black font-sans text-base md:text-xl uppercase overflow-hidden transition-all duration-300 hover:scale-105 active:scale-95 transform-gpu bg-cyan-500/10 backdrop-blur-md text-cyan-400 ring-1 ring-inset ring-cyan-400/30 hover:ring-cyan-400/60 hover:bg-cyan-500/20 hover:shadow-[0_0_30px_rgba(34,211,238,0.25)]"
>
    <!-- Kontener tekstów - idealnie wyśrodkowany za pomocą gridu -->
    <div class="relative z-10 grid place-items-center w-full">
        <span id="heroTextDefault" class="col-start-1 row-start-1 transition-all duration-300 opacity-100 scale-100"
              style="letter-spacing: 0.3em; margin-right: -0.3em;">
            {ip}
        </span>
        
        <span id="heroTextCopied" class="col-start-1 row-start-1 transition-all duration-300 opacity-0 scale-90 font-black italic text-white"
              style="letter-spacing: 0.3em; margin-right: -0.3em; text-shadow: 0 0 20px rgba(255,255,255,0.9);">
            COPIED!
        </span>
    </div>
</button>

<script>
    const heroBtn         = document.getElementById('heroCopyBtn') as HTMLButtonElement | null;
    const heroTextDefault = document.getElementById('heroTextDefault');
    const heroTextCopied  = document.getElementById('heroTextCopied');

    const defaultClasses = ["bg-cyan-500/10", "text-cyan-400", "ring-1", "ring-inset", "ring-cyan-400/30", "hover:ring-cyan-400/60", "hover:bg-cyan-500/20", "hover:shadow-[0_0_30px_rgba(34,211,238,0.25)]"];
    const activeClasses = ["bg-gradient-to-r", "from-cyan-500", "to-blue-600", "text-white", "shadow-[0_0_40px_rgba(34,211,238,0.5)]"];

    async function copyText(value: string) {
        if (!value) return;
        try {
            await navigator.clipboard.writeText(value);
        } catch {
            const helper = document.createElement('textarea');
            helper.value = value;
            helper.setAttribute('readonly', '');
            helper.style.position = 'absolute';
            helper.style.left = '-9999px';
            document.body.appendChild(helper);
            helper.select();
            document.execCommand('copy');
            document.body.removeChild(helper);
        }
    }

    if (heroBtn && !heroBtn.dataset.copyBound) {
        heroBtn.dataset.copyBound = 'true';

        heroBtn.addEventListener('click', async () => {
            const ip = heroBtn.getAttribute('data-ip') || '';
            await copyText(ip);

            heroBtn.classList.remove(...defaultClasses);
            heroBtn.classList.add(...activeClasses);

            heroTextDefault?.classList.replace('opacity-100', 'opacity-0');
            heroTextDefault?.classList.add('scale-90');
            heroTextCopied?.classList.replace('opacity-0', 'opacity-100');
            heroTextCopied?.classList.replace('scale-90', 'scale-100');

            setTimeout(() => {
                heroBtn.classList.remove(...activeClasses);
                heroBtn.classList.add(...defaultClasses);

                heroTextDefault?.classList.replace('opacity-0', 'opacity-100');
                heroTextDefault?.classList.remove('scale-90');
                heroTextCopied?.classList.replace('opacity-100', 'opacity-0');
                heroTextCopied?.classList.replace('scale-100', 'scale-90');
            }, 1800);
        });
    }
</script>

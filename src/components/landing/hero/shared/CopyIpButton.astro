---
interface Props {
    ip: string;
    label?: string;
}
const { ip } = Astro.props;
---

<button
    id="heroCopyBtn"
    type="button"
    data-ip={ip}
    aria-label="Copy server IP address"
    class="copy-ip-btn"
>
    <span class="copy-ip-text copy-ip-text--default" style="letter-spacing:0.3em;margin-right:-0.3em">{ip}</span>
    <span class="copy-ip-text copy-ip-text--copied" style="letter-spacing:0.3em;margin-right:-0.3em">COPIED!</span>
</button>

<style>
    .copy-ip-btn {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        padding: 1rem 2rem;
        border: none;
        border-radius: 1rem;
        font-family: inherit;
        font-weight: 900;
        font-size: 1rem;
        text-transform: uppercase;
        cursor: pointer;
        overflow: hidden;
        transition: transform 0.3s ease, background 0.3s ease, box-shadow 0.3s ease;
        transform: translateZ(0);

        /* Default state: dark glass with cyan ring */
        background: rgba(6, 182, 212, 0.1);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        color: #22d3ee;
        box-shadow: inset 0 0 0 1px rgba(34, 211, 238, 0.3);
    }

    @media (min-width: 768px) {
        .copy-ip-btn {
            padding: 1.25rem 3rem;
            font-size: 1.25rem;
        }
    }

    .copy-ip-btn:hover {
        transform: scale(1.05);
        box-shadow: inset 0 0 0 1px rgba(34, 211, 238, 0.6);
        background: rgba(6, 182, 212, 0.2);
    }

    .copy-ip-btn:active {
        transform: scale(0.95);
    }

    /* Copied state — applied via JS */
    .copy-ip-btn.is-copied {
        background: linear-gradient(to right, #06b6d4, #2563eb);
        color: #fff;
        box-shadow: 0 0 40px rgba(34, 211, 238, 0.5);
    }

    .copy-ip-btn.is-copied:hover {
        transform: scale(1.05);
        box-shadow: 0 0 40px rgba(34, 211, 238, 0.5);
    }

    /* Text container – stacked grid for crossfade */
    .copy-ip-text {
        grid-area: 1 / 1;
        transition: opacity 0.3s ease, transform 0.3s ease;
    }

    .copy-ip-btn {
        display: grid;
        place-items: center;
    }

    .copy-ip-text--default {
        opacity: 1;
        transform: scale(1);
    }

    .copy-ip-text--copied {
        opacity: 0;
        transform: scale(0.9);
        font-style: italic;
        text-shadow: 0 0 20px rgba(255, 255, 255, 0.9);
    }

    /* When copied */
    .copy-ip-btn.is-copied .copy-ip-text--default {
        opacity: 0;
        transform: scale(0.9);
    }

    .copy-ip-btn.is-copied .copy-ip-text--copied {
        opacity: 1;
        transform: scale(1);
    }
</style>

<script>
    function initCopyBtn() {
        const btn = document.getElementById('heroCopyBtn') as HTMLButtonElement | null;
        if (!btn || btn.dataset.bound) return;
        btn.dataset.bound = '1';

        btn.addEventListener('click', async () => {
            const ip = btn.dataset.ip || '';
            if (!ip) return;

            // Copy to clipboard
            try {
                await navigator.clipboard.writeText(ip);
            } catch {
                const ta = Object.assign(document.createElement('textarea'), {
                    value: ip,
                    readOnly: true,
                });
                ta.style.cssText = 'position:absolute;left:-9999px';
                document.body.appendChild(ta);
                ta.select();
                document.execCommand('copy');
                document.body.removeChild(ta);
            }

            // Visual feedback
            btn.classList.add('is-copied');
            setTimeout(() => btn.classList.remove('is-copied'), 1800);
        });
    }

    // Run on initial load & on Astro view transitions
    initCopyBtn();
    document.addEventListener('astro:after-swap', initCopyBtn);
</script>

---
// src/components/landing/Hero/Hero.astro
import heroData from '/src/data/hero.json';
import CopyIpButton from 'src/components/landing/hero/shared/CopyIpButton.astro';
import { gradients } from 'src/components/gradients.js';

const { badge, titleFirst, titleSecond, description, serverIP, ctaPrimary } = heroData;

const titleGradient   = gradients.fuchsia_pulse.cssAnimated;
const badgeColor      = gradients.fuchsia_pulse.primary;   // #FF00CC
const badgeGlow       = 'rgba(255,0,204,0.22)';
---

<section class="relative min-h-[60vh] md:min-h-[90vh] flex items-center justify-center pt-24 pb-10 md:pt-10 md:pb-0">

    <!-- Synthwave blobs -->
    <div class="absolute top-1/4 -left-10 w-[200px] h-[200px] sm:w-[300px] sm:h-[300px] md:w-[500px] md:h-[500px] blur-[60px] md:blur-[150px] animate-pulse pointer-events-none" style={`background: ${badgeGlow};`}></div>
    <div class="absolute bottom-1/4 -right-10 w-[200px] h-[200px] sm:w-[300px] sm:h-[300px] md:w-[500px] md:h-[500px] blur-[60px] md:blur-[150px] animate-pulse pointer-events-none" style="background: rgba(0, 225, 253, 0.18); animation-delay: 2s;"></div>



    <div class="relative z-10 text-center px-8 max-w-7xl mx-auto">

        <div class="flex items-center justify-center gap-3 md:gap-4 mb-6 md:mb-10 animate-fade-in-up">
            <div class="h-px w-12 md:w-24 transition-colors duration-700" style={`background: ${badgeColor}; box-shadow: 0 0 10px ${badgeColor};`}></div>
            <span class="text-[9px] md:text-[11px] font-black uppercase tracking-[0.4em] md:tracking-[0.6em]" style={`color: ${badgeColor}; text-shadow: 0 0 15px ${badgeColor};`}>
                {badge}
            </span>
            <div class="h-px w-12 md:w-24 transition-colors duration-700" style={`background: ${badgeColor}; box-shadow: 0 0 10px ${badgeColor};`}></div>
        </div>

        <h1 class="text-5xl sm:text-7xl md:text-8xl lg:text-[120px] xl:text-[160px] font-black italic tracking-tighter leading-[0.9] uppercase flex flex-col md:flex-row items-center justify-center gap-0 md:gap-6 mb-4 md:mb-8">
            <span class="text-white drop-shadow-[0_0_20px_rgba(255,255,255,0.1)] md:drop-shadow-[0_0_30px_rgba(255,255,255,0.1)]">
                {titleFirst}
            </span>
            <span class="neon-text-animated" style={`background-image: ${titleGradient}; filter: drop-shadow(0 0 40px rgba(255,0,204,0.55));`}>
                {titleSecond}
            </span>
        </h1>

        <p class="text-white/50 text-sm md:text-xl font-medium tracking-wide max-w-lg md:max-w-2xl mx-auto mb-8 md:mb-12 leading-relaxed px-2">
            {description}
        </p>

        <div class="flex flex-col items-center gap-6 w-full">

            <div class="w-full sm:w-[400px] flex justify-center [&>button]:w-full">
                <CopyIpButton ip={serverIP} label={ctaPrimary} />
            </div>

            <div class="flex flex-col sm:flex-row items-center justify-center gap-4 md:gap-6 w-full sm:w-auto">

                <a href="#modes"
                   class="relative w-full sm:w-[260px] flex items-center justify-center py-3 md:py-4 text-white font-black uppercase text-[10px] rounded-2xl transition-all duration-300 hover:scale-110 group"
                   style="background: #00E1FD; box-shadow: 0 0 20px rgba(0,225,253,0.45), 0 0 40px rgba(0,225,253,0.15); letter-spacing: 0.3em;"
                >
                    <span style="margin-right: -0.3em;">EXPLORE MODES</span>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="absolute right-6 w-4 h-4 group-hover:translate-y-0.5 transition-transform">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5L12 21m0 0l-7.5-7.5M12 21V3" />
                    </svg>
                </a>

                <a href="#team"
                   class="relative w-full sm:w-[260px] flex items-center justify-center py-3 md:py-4 text-white font-black uppercase text-[10px] rounded-2xl transition-all duration-300 hover:scale-110 group"
                   style="background: #FF00CC; box-shadow: 0 0 20px rgba(255,0,204,0.45), 0 0 40px rgba(255,0,204,0.15); letter-spacing: 0.3em;"
                >
                    <span style="margin-right: -0.3em;">MEET THE TEAM</span>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="absolute right-6 w-4 h-4 group-hover:translate-y-0.5 transition-transform">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5L12 21m0 0l-7.5-7.5M12 21V3" />
                    </svg>
                </a>

            </div>
        </div>
    </div>
</section>

<script>
    // Zostawiłem tylko smooth scroll dla kotwic (#) - resztę logiki przycisku obsługuje sam copyipbutton.astro
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
            e.preventDefault();
            const target = document.querySelector(this.getAttribute('href') || '');
            if (target) {
                target.scrollIntoView({
                    behavior: 'smooth'
                });
            }
        });
    });
</script>

<style>
    @keyframes fade-in-up {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in-up {
        animation: fade-in-up 0.8s cubic-bezier(0.23, 1, 0.32, 1) forwards;
    }
    /* Płynne przewijanie na poziomie całej strony */
    html {
        scroll-behavior: smooth;
    }
</style>
---
const currentYear = new Date().getFullYear();
import { gradients } from 'src/components/gradients.js';

// kolorystyka dla footeru (bazujemy na fuksji dla spójności)
const themeHex = '#FF00CC';
const themeRgb = '255,0,204';
const ambient = gradients.fuchsia_pulse.cssDiag;
const titleGradient = gradients.fuchsia_pulse.cssAnimated;
---

<footer class="relative mt-20 pb-12" style={`--theme-hex: ${themeHex}; --theme-rgb: ${themeRgb};`}>
    {/* Bloom pod całym footerem */}
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-full h-[400px] blur-[120px] -z-10" style={`pointer-events:none; background-image: ${ambient}; opacity: 0.15;`}></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8">
        
        <div class="bg-gradient-to-br from-white/5 to-white/[0.02] backdrop-blur-3xl border-[rgba(var(--theme-rgb),0.3)] hover:border-[rgba(var(--theme-rgb),0.6)] shadow-[0_0_50px_rgba(var(--theme-rgb),0.2)] hover:shadow-[0_0_80px_rgba(var(--theme-rgb),0.3)] rounded-[2.5rem] md:rounded-[4rem] p-8 md:p-14 relative overflow-hidden group transition-all duration-700">

            {/* Bloom wewnętrzny (ModeCard style) */}
            <div class="absolute -inset-[60px] rounded-[2.5rem] md:rounded-[4rem] blur-[80px] -z-10 pointer-events-none transition-all duration-1000 opacity-10" style={`background-image: ${ambient};`}></div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 relative z-10">

                <div class="lg:col-span-5 space-y-6 md:space-y-8">
                    <h2 class="text-4xl md:text-5xl font-black italic uppercase tracking-tighter text-white leading-none mb-4 md:mb-6">
                        <span class="text-white drop-shadow-[0_0_15px_rgba(255,255,255,0.1)]">TURBO</span>
                        <span class="neon-text-animated pr-2" style={`background-image: ${titleGradient}; filter: drop-shadow(0 0 20px rgba(var(--theme-rgb),0.35));`}>BLOCKS</span>
                    </h2>
                    
                    {/* Opis ze standardowym lewym borderem */}
                    <p class="text-white/60 text-sm md:text-base font-medium italic border-l-4 border-white/10 pl-6 leading-relaxed max-w-sm">
                        Top-tier minigames with a <span class="text-white">neon-futuristic</span> vibe.
                        Crafted with passion by Velocity Vale Studios.
                    </p>

                    <div class="flex items-center gap-3 px-4 md:px-5 py-3 bg-white/5 rounded-2xl w-fit border border-white/10 backdrop-blur-md">
                        <div class="w-2 h-2 bg-green-500 rounded-full animate-pulse shadow-[0_0_15px_#22c55e]"></div>
                        <span class="text-[9px] md:text-xs font-black uppercase tracking-widest text-white/60">Server Status: <span class="text-white">Online</span></span>
                    </div>
                </div>

                <div class="lg:col-span-3 space-y-6 md:space-y-8">
                    {/* Nagłówek w stylu Pill z ModeCard */}
                    <span class="inline-block text-[9px] md:text-[11px] font-black uppercase tracking-[0.3em] py-2 px-4 rounded-xl border border-white/10 shadow-2xl"
                          style={`color: var(--theme-hex); background: rgba(var(--theme-rgb), 0.08); box-shadow: inset 0 0 0 1px rgba(var(--theme-rgb),0.25);`}>
                        NAVIGATION
                    </span>
                    <ul class="space-y-4 pl-2">
                        <li><a href="/terms" class="text-xs md:text-sm font-bold text-white/40 hover:text-white hover:translate-x-2 transition-all inline-block uppercase tracking-widest">Terms of Service</a></li>
                        <li><a href="/privacy" class="text-xs md:text-sm font-bold text-white/40 hover:text-white hover:translate-x-2 transition-all inline-block uppercase tracking-widest">Privacy Policy</a></li>
                        <li><a href="/help" class="text-xs md:text-sm font-bold text-white/40 hover:text-white hover:translate-x-2 transition-all inline-block uppercase tracking-widest">Help Center</a></li>
                    </ul>
                </div>

                <div class="lg:col-span-4 space-y-6 md:space-y-8">
                    {/* Nagłówek w stylu Pill z ModeCard */}
                    <span class="inline-block text-[9px] md:text-[11px] font-black uppercase tracking-[0.3em] py-2 px-4 rounded-xl border border-white/10 shadow-2xl"
                          style={`color: var(--theme-hex); background: rgba(var(--theme-rgb), 0.08); box-shadow: inset 0 0 0 1px rgba(var(--theme-rgb),0.25);`}>
                        LEGAL
                    </span>
                    <p class="text-[9px] md:text-[10px] leading-relaxed text-white/40 uppercase font-bold tracking-widest pl-2">
                        TurboBlocks is not an official Minecraft product. We are not approved by or associated with Mojang AB.
                        All trademarks belong to their respective owners.
                    </p>
                    <div class="pt-6 border-t border-white/10 pl-2">
                        <p class="text-[9px] md:text-[10px] font-black text-white/60 uppercase tracking-[0.3em]">
                            &copy; {currentYear} <span class="text-white hover:text-[#00E1FD] transition-colors cursor-default drop-shadow-[0_0_10px_rgba(255,255,255,0.3)]">Velocity Vale Studios</span>
                        </p>
                    </div>
                </div>

            </div>
        </div>

        <div class="mt-8 flex flex-col md:flex-row justify-between items-center px-4 md:px-8 gap-4 opacity-40 hover:opacity-100 transition-opacity duration-700">
            <div class="flex gap-6">
                <span class="text-[8px] md:text-[9px] font-bold text-white uppercase tracking-[0.4em]">Built with Astro & Qwik</span>
            </div>
            <div class="text-[8px] md:text-[9px] font-bold text-white uppercase tracking-[0.4em]">
                Color Clash Season One // v1.0.0
            </div>
        </div>
    </div>
</footer>
---
import { gradients } from 'src/components/gradients.js';

const cartGradient = gradients.fuchsia_pulse.cssAnimated;
const btnGradient = gradients.fuchsia_pulse.css;
---
<div id="cart-drawer" class="hidden lg:flex fixed top-28 right-4 md:right-8 z-[9000] flex-col pointer-events-none opacity-0 translate-x-4 transition-all duration-500 ease-out w-[420px] max-h-[calc(100vh-140px)]">

    <div style="--cart-hex: #FF00CC; --cart-rgb: 255,0,204;" class="w-full bg-[#0a0514]/90 backdrop-blur-3xl border border-white/10 rounded-[2rem] overflow-hidden flex flex-col relative group">

        {/* Header */}
        <div class="px-8 py-7 flex justify-between items-start border-b border-white/5 shrink-0 relative z-10">
            <div class="flex flex-col items-start">
                <div class="flex justify-between items-start mb-2">
                    <span class="text-[9px] font-black uppercase tracking-[0.3em] py-1.5 px-3 rounded-xl border border-transparent shadow-2xl"
                          style={`color: var(--cart-hex); background: rgba(var(--cart-rgb), 0.08); box-shadow: inset 0 0 0 1px rgba(var(--cart-rgb),0.25);`}>
                        CART PREVIEW
                    </span>
                </div>
                <h2 class="text-3xl font-black italic text-white uppercase tracking-tighter leading-none mt-2">
                    YOUR <span class="neon-text-animated pr-2" style={`background-image: ${cartGradient};`}>CART</span>
                </h2>
            </div>
            <button
                onclick="toggleCart(false)"
                type="button"
                aria-label="Close cart preview"
                class="w-10 h-10 flex items-center justify-center bg-white/5 border border-white/10 text-white/50 rounded-2xl hover:bg-[rgba(var(--cart-rgb),0.1)] hover:border-[rgba(var(--cart-rgb),0.3)] hover:text-white hover:rotate-90 transition-all duration-300 relative z-10"
            >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>

        {/* Items List */}
        <div id="cart-list" class="overflow-y-auto max-h-[340px] px-6 py-5 flex flex-col gap-3 relative z-10">
            <div class="h-full flex flex-col items-center justify-center text-center opacity-60 py-12">
                <div class="w-16 h-16 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center mb-4 shadow-[0_0_30px_rgba(255,255,255,0.05)]">
                    <svg class="w-8 h-8 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z" /></svg>
                </div>
                <p class="text-white italic uppercase text-[11px] font-black tracking-[0.2em] mb-1">Cart is Empty</p>
                <a href="/shop" class="mt-2 text-[10px] font-black text-pink-400 uppercase tracking-widest hover:text-white transition-colors">Go to Shop →</a>
            </div>
        </div>

        {/* Footer: Total + Checkout */}
        <div class="px-8 py-6 border-t border-[rgba(var(--cart-rgb),0.15)] bg-black/20 shrink-0 relative z-10">
            <div class="flex justify-between items-center mb-6">
                <div class="flex flex-col gap-1">
                    <span class="text-[9px] font-black text-white/40 uppercase tracking-[0.3em]">Total Value</span>
                    <div class="flex items-baseline gap-2">
                        <span id="cart-total" class="text-2xl font-black italic text-cyan-400 tracking-tighter">0 TC</span>
                        <span id="cart-total-pln" class="text-xs font-black text-white/60 uppercase tracking-widest">0.00 zł</span>
                    </div>
                </div>
                <span id="cart-item-count" class="text-[9px] font-black py-1.5 px-3 rounded-lg bg-white/5 border border-white/10 text-white/40 uppercase tracking-widest">0 items</span>
            </div>

            <a id="checkout-btn" href="/checkout" class="relative overflow-hidden w-full py-4 rounded-2xl text-white font-black uppercase tracking-[0.2em] text-[11px] transition-all duration-300 hover:bg-white/10 flex items-center justify-center gap-3 border border-white/10 group/btn no-underline bg-gradient-to-r from-fuchsia-600 to-purple-600">
                <span class="relative z-10 transition-transform duration-300 group-hover/btn:translate-x-[-4px]">Proceed to Checkout</span>
                <span class="relative z-10 opacity-70 transition-all duration-300 group-hover/btn:opacity-100 group-hover/btn:translate-x-[4px]">→</span>
            </a>
        </div>
    </div>
</div>

<script is:inline>
    const CART_STORAGE_KEY = 'turbo_cart_v1';
    window.cart = JSON.parse(localStorage.getItem(CART_STORAGE_KEY) || '[]');

    const saveCart = (animate) => {
        localStorage.setItem(CART_STORAGE_KEY, JSON.stringify(window.cart));
        updateCartUI(animate);
    };

    let isCartExpanded = false;

    window.toggleCart = (forceState) => {
        const drawer = document.getElementById('cart-drawer');
        if (!drawer) return;
        isCartExpanded = (typeof forceState === 'boolean') ? forceState : !isCartExpanded;
        if (isCartExpanded) {
            drawer.classList.remove('opacity-0', 'pointer-events-none', 'translate-x-4');
            drawer.classList.add('opacity-100', 'pointer-events-auto', 'translate-x-0');
            updateCartUI(false);
        } else {
            drawer.classList.add('opacity-0', 'pointer-events-none', 'translate-x-4');
            drawer.classList.remove('opacity-100', 'pointer-events-auto', 'translate-x-0');
        }
    };

    window.addToCart = (item) => {
        window.cart.push(item);
        saveCart(true);
        if (window.innerWidth >= 1024) window.toggleCart(true);
    };

    window.removeFromCart = (index) => {
        window.cart.splice(index, 1);
        saveCart(false);
    };

    window.addEventListener('shop:add', (e) => {
        if (e.detail) window.addToCart(e.detail);
    });

    function getRarityPillClass(rarity) {
        switch(rarity) {
            case 'Legendary': return 'bg-yellow-500/15 border border-yellow-500/30 text-yellow-400 shadow-[0_0_10px_rgba(234,179,8,0.2)]';
            case 'Epic':      return 'bg-purple-500/15 border border-purple-500/30 text-purple-400 shadow-[0_0_10px_rgba(168,85,247,0.2)]';
            case 'Rare':      return 'bg-blue-500/15 border border-blue-500/30 text-blue-400 shadow-[0_0_10px_rgba(59,130,246,0.2)]';
            case 'Uncommon':  return 'bg-green-500/15 border border-green-500/30 text-green-400 shadow-[0_0_10px_rgba(34,197,94,0.2)]';
            default:          return 'bg-white/5 border border-white/10 text-white/50';
        }
    }

    function updateCartUI(animate) {
        const list = document.getElementById('cart-list');
        const totalDisplay = document.getElementById('cart-total');
        const totalPlnDisplay = document.getElementById('cart-total-pln');
        const countDisplay = document.getElementById('cart-item-count');
        const checkoutBtn = document.getElementById('checkout-btn');
        const navbarBadge = document.getElementById('navbar-cart-count');

        const parseTc = (item) => {
            if (item.isCoinPack || item.type === 'Coin Pack') return 0;
            if (typeof item.priceTc === 'number') return item.priceTc;
            return parseInt(String(item.price || '').replace(/[^0-9]/g, ''), 10) || 0;
        };
        const parseAmountTc = (item) => {
            if (typeof item.amountTc === 'number') return item.amountTc;
            if (typeof item.tcAmount === 'number') return item.tcAmount;
            return parseInt(String(item.price || '').replace(/[^0-9]/g, ''), 10) || 0;
        };
        const parsePln = (item) => {
            if (typeof item.pricePln === 'number') return item.pricePln;
            if (typeof item.cashPricePln === 'number') return item.cashPricePln;
            const normalized = String(item.cashPrice || '').replace(',', '.');
            const matched = normalized.match(/[0-9]+(?:\.[0-9]+)?/);
            return matched ? parseFloat(matched[0]) : 0;
        };

        if (navbarBadge) {
            navbarBadge.innerText = window.cart.length;
            navbarBadge.style.opacity = window.cart.length > 0 ? '1' : '0';
            if (animate) {
                navbarBadge.classList.remove('animate-cart-pop');
                void navbarBadge.offsetWidth;
                navbarBadge.classList.add('animate-cart-pop');
            }
        }

        if (!list || !totalDisplay) return;

        if (countDisplay) {
            const n = window.cart.length;
            countDisplay.innerText = n === 0 ? '0 items' : n === 1 ? '1 item' : n + ' items';
        }

        if (window.cart.length === 0) {
            list.innerHTML = '<div class="h-full flex flex-col items-center justify-center text-center opacity-60 py-12"><div class="w-16 h-16 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center mb-4 shadow-[0_0_30px_rgba(255,255,255,0.05)]"><svg class="w-8 h-8 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z" /></svg></div><p class="text-white italic uppercase text-[11px] font-black tracking-[0.2em] mb-1">Cart is Empty</p><a href="/shop" class="mt-2 text-[10px] font-black text-pink-400 uppercase tracking-widest hover:text-white transition-colors no-underline">Go to Shop →</a></div>';
            totalDisplay.innerText = '0 TC';
            if (totalPlnDisplay) totalPlnDisplay.innerText = '0.00 zł';
            if (checkoutBtn) { checkoutBtn.style.pointerEvents = 'none'; checkoutBtn.style.opacity = '0.5'; checkoutBtn.style.filter = 'grayscale(100%)'; }
        } else {
            list.innerHTML = '';
            let totalTc = 0;
            let totalPln = 0;
            window.cart.forEach((item, index) => {
                const isCoinPack = item.isCoinPack || item.type === 'Coin Pack';
                const priceTc = parseTc(item);
                const amountTc = parseAmountTc(item);
                const pricePln = parsePln(item);
                totalTc += priceTc;
                totalPln += pricePln;
                const hasPln = pricePln > 0;
                const tcPill = !isCoinPack
                    ? ('<span class="text-[9px] font-bold px-2 py-0.5 rounded-full ' + getRarityPillClass(item.rarity) + '">' + (priceTc || 0) + ' TC</span>')
                    : '';
                const plnPill = hasPln
                    ? ('<span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-amber-400/10 border border-amber-400/30 text-amber-200">' + pricePln.toFixed(2) + ' zł</span>')
                    : '';
                const amountLabel = isCoinPack && amountTc > 0
                    ? ('<p class="text-[8px] text-pink-300/90 font-black uppercase tracking-widest mt-1">You get ' + amountTc + ' TC</p>')
                    : '';
                const el = document.createElement('div');
                el.className = "group/item flex items-center gap-3 bg-white/5 border border-white/10 p-3 rounded-2xl transition-all hover:bg-white/10 hover:border-pink-500/40 hover:shadow-[0_0_25px_rgba(255,0,204,0.15)] shrink-0 cursor-default";
                el.innerHTML = '<div class="w-12 h-12 bg-black/20 rounded-xl flex items-center justify-center text-xl border border-white/5 shrink-0 transition-all group-hover/item:border-pink-500/50 group-hover/item:shadow-[0_0_15px_rgba(255,0,204,0.2)]">' + (item.icon||'📦') + '</div><div class="flex-grow overflow-hidden"><p class="text-[11px] font-black text-white uppercase italic tracking-tighter truncate pr-2 transition-colors group-hover/item:text-pink-100">' + item.name + '</p><div class="flex items-center gap-2 mt-1">' + tcPill + plnPill + '<span class="text-[8px] text-white/30 font-bold uppercase tracking-wider">' + (item.rarity||'') + '</span></div>' + amountLabel + ((item.bonus && isCoinPack) ? ('<p class="text-[8px] font-black uppercase tracking-widest text-amber-300/80 mt-1">' + item.bonus + '</p>') : '') + '</div><button type="button" aria-label="Remove item from cart" onclick="removeFromCart(' + index + ')" class="w-8 h-8 rounded-xl flex items-center justify-center text-white/30 hover:text-white hover:bg-red-500 hover:shadow-[0_0_15px_rgba(239,68,68,0.5)] border border-transparent hover:border-red-400 transition-all shrink-0"><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg></button>';
                list.appendChild(el);
            });
            totalDisplay.innerText = totalTc + ' TC';
            if (totalPlnDisplay) { totalPlnDisplay.innerText = totalPln.toFixed(2) + ' zł'; totalPlnDisplay.style.display = totalPln > 0 ? '' : 'none'; }
            if (checkoutBtn) { checkoutBtn.style.pointerEvents = ''; checkoutBtn.style.opacity = ''; checkoutBtn.style.filter = ''; }
        }
    }

    updateCartUI(false);
</script>

<style is:global>
    @keyframes cart-bounce {
        0% { transform: scale(1); }
        25% { transform: scale(1.5); background-color: #FF00CC; color: white; box-shadow: 0 0 15px rgba(255, 0, 204, 0.6); }
        40% { transform: scale(0.9); }
        60% { transform: scale(1.15); }
        100% { transform: scale(1); background-color: white; color: #FF00CC; box-shadow: none; }
    }
    .animate-cart-pop {
        animation: cart-bounce 0.6s cubic-bezier(0.25, 1, 0.5, 1);
    }
</style>

---
import DesktopCopyIP from './DesktopCopyIP.astro';
import DesktopNavLinks from './DesktopNavLinks.astro';
import DiscordBtn from '../shared/DiscordBtn.astro';
import CartTrigger from '../shared/CartTrigger.astro';
import { gradients } from 'src/components/gradients.js';

interface Props {
    config: any;
    currentPath: string;
}

const { config, currentPath } = Astro.props;

const animClasses = "transition-all duration-300 hover:scale-105 active:scale-95 transform-gpu";
const purpleGradient = "bg-gradient-to-r from-pink-500 to-purple-600 text-white hover:shadow-[0_0_15px_rgba(236,72,153,0.4)]";
---

<header class="hidden lg:block fixed top-4 left-0 right-0 mx-auto w-[94%] max-w-7xl z-50 bg-white/[0.02] backdrop-blur-2xl border border-white/10 py-4 rounded-[2rem]"
        style="box-shadow: 0 20px 50px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,0,204,0.08), 0 0 60px rgba(0,212,255,0.06);">
    <div class="relative w-full px-2 sm:px-4 flex justify-between items-center">

        <div class="flex items-center gap-1.5 sm:gap-4">
            <DesktopCopyIP config={config} />
            <DiscordBtn config={config} />
        </div>

        <DesktopNavLinks config={config} currentPath={currentPath} />

        <div class="flex items-center gap-1.5 sm:gap-4">
            <a href={config.shop.href} aria-label="Open shop page"
               class={`relative flex items-center justify-center w-9 h-9 sm:w-10 sm:h-10 lg:w-auto lg:px-6 rounded-2xl text-white overflow-hidden group ${purpleGradient} ${animClasses}`}
            >
                <div class="absolute inset-0 rounded-2xl bg-white/0 group-hover:bg-white/10 transition-colors duration-300 pointer-events-none"></div>
                <svg class="relative z-10 w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                </svg>
                <span class="relative z-10 hidden lg:block font-bold font-sans text-xs tracking-[0.2em] ml-3">{config.shop.name}</span>
            </a>

            <CartTrigger />
        </div>

    </div>
</header>

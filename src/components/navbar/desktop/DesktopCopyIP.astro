---
interface Props {
    config: any;
}
const { config } = Astro.props;
const animClasses = "transition-all duration-300 hover:scale-105 active:scale-95 transform-gpu";
---

<button
        id="copyIPDesktop"
        type="button"
        data-ip={config.server.ip}
        aria-label="Copy server IP address"
        class={`relative flex items-center justify-center lg:gap-3 px-4 lg:px-6 h-9 sm:h-10 bg-cyan-500/10 backdrop-blur-md rounded-2xl text-cyan-400 font-bold font-sans text-xs tracking-widest ring-1 ring-inset ring-cyan-400/30 hover:ring-cyan-400/60 hover:bg-cyan-500/20 hover:shadow-[0_0_20px_rgba(34,211,238,0.2)] overflow-hidden group ${animClasses}`}
>
    <div class="relative z-10 grid place-items-center">
        <span id="ipTextDefault" class="col-start-1 row-start-1 transition-all duration-300 opacity-100 scale-100">{config.server.ip}</span>
        <span id="ipTextCopied" class="col-start-1 row-start-1 transition-all duration-300 opacity-0 scale-90 text-white absolute">COPIED!</span>
    </div>
</button>

<script>
    const copyBtn = document.getElementById('copyIPDesktop');
    const textDefault = document.getElementById('ipTextDefault');
    const textCopied = document.getElementById('ipTextCopied');

    const defaultColors = ["bg-cyan-500/10", "text-cyan-400"];
    const activeColors = ["bg-gradient-to-r", "from-cyan-500", "to-blue-600", "text-white", "shadow-[0_0_20px_rgba(34,211,238,0.5)]"];

    async function copyText(value) {
        if (!value) return;
        try {
            await navigator.clipboard.writeText(value);
        } catch {
            const helper = document.createElement('textarea');
            helper.value = value;
            helper.setAttribute('readonly', '');
            helper.style.position = 'absolute';
            helper.style.left = '-9999px';
            document.body.appendChild(helper);
            helper.select();
            document.execCommand('copy');
            document.body.removeChild(helper);
        }
    }

    if (copyBtn && !copyBtn.dataset.copyBound) {
        copyBtn.dataset.copyBound = 'true';
        copyBtn.addEventListener('click', async () => {
        const ip = copyBtn.getAttribute('data-ip') || 'play.turboblocks.eu';
        await copyText(ip);

        copyBtn.classList.remove(...defaultColors);
        copyBtn.classList.add(...activeColors);

        textDefault?.classList.replace('opacity-100', 'opacity-0');
        textDefault?.classList.add('scale-90');
        textCopied?.classList.replace('opacity-0', 'opacity-100');
        textCopied?.classList.replace('scale-90', 'scale-100');

        setTimeout(() => {
            copyBtn.classList.remove(...activeColors);
            copyBtn.classList.add(...defaultColors);
            textDefault?.classList.replace('opacity-0', 'opacity-100');
            textDefault?.classList.remove('scale-90');
            textCopied?.classList.replace('opacity-100', 'opacity-0');
            textCopied?.classList.replace('scale-100', 'scale-90');
        }, 1500);
        });
    }
</script>